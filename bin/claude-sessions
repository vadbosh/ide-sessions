#!/usr/bin/env bash
# claude-sessions: list Claude Code sessions across ALL projects with their
# bound cwd + last-activity time, sorted newest-first.
#
# Why this exists: Claude Code's project-hash (and thus --resume/-c lookup
# scope) is fixed to whatever cwd was active when `claude` was launched, and
# never changes afterward even if you `cd` inside the running session's Bash
# tool. That mismatch between "where I think I am" and "what dir a session
# is actually filed under" is easy to lose track of (confirmed the hard way:
# a session launched from ap-southeast-2/cluster-a silently carried a whole
# day's us-east-1 work because nobody ever exited/relaunched claude). This
# script surfaces id + real bound dir + recency so that's visible up front,
# instead of discovered after the fact by grepping raw .jsonl.
#
# Usage:
#   claude-sessions              # all sessions, newest first
#   claude-sessions -n 20        # limit to 20 rows
#   claude-sessions <substring>  # filter by dir substring
#   claude-sessions -f           # show full dir path instead of last 3 components
#
# Deleting:
#   claude-sessions --rm <ID>[,<ID>...]        # asks to confirm, then deletes
#   claude-sessions --older-than 30            # bulk: dry-run, needs --apply
#   claude-sessions --max-turns 2              # bulk: dry-run, needs --apply
#   claude-sessions --older-than 30 --apply
#
# Naming an id is intent enough, so --rm confirms and deletes. Bulk criteria can
# match far more than expected, so they print a dry-run until --apply is passed.
#
# A session is not just its transcript: subagent logs, file-history, session-env,
# usage-data and security state are all keyed by session id. Delete removes the
# whole footprint, moving it to a trash dir rather than unlinking, so a mistake
# stays recoverable.

set -euo pipefail

CONFIG_DIR="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
PROJECTS_DIR="$CONFIG_DIR/projects"
TRASH_ROOT="${IDE_SESSIONS_TRASH:-$HOME/.cache/ide-sessions-trash}"
SUM_CACHE="${IDE_SESSIONS_SUM_CACHE:-$HOME/.cache/ide-sessions-summaries}"
LIMIT=0
FILTER=""
FULL_PATH=0
PROJECT_SCOPE=0
RM_IDS=""
RM_ALL=0
OLDER_THAN=""
MAX_TURNS=""
APPLY=0
ASSUME_YES=0
DRY_RUN=0
SUM_ID=""
SUM_MODEL="${IDE_SESSIONS_SUM_MODEL:-}"
SUM_GAP=45
SUM_REFRESH=0
SUM_RAW=0
SUM_LANG=en

usage() {
  cat <<'EOF'
Usage: claude-sessions [-n LIMIT] [-f] [-p] [substring]
       claude-sessions --sum <ID>
       claude-sessions --sum-orig <ID>
       claude-sessions --rm <ID>[,<ID>...]
       claude-sessions -p --rm-all --apply
       claude-sessions --older-than DAYS | --max-turns N --apply

  -n LIMIT          limit rows
  -f                full dir path instead of last 3 components
  -p                scope to the exact project-hash dir for $PWD (like 'rtk gain -p')
  substring         filter by dir substring

Summary of one session, grouped by topic (English unless --sum-orig):
  --sum ID          summarize that session; the result is cached per transcript
  --sum-model M     model to summarize with (default: cheapest one available)
  --sum-gap MIN     minutes of silence that start a new topic (default: 45)
  --sum-refresh     ignore the cached summary and ask the model again
  --sum-raw         print the extracted digest only — no model call, no cost
  --sum-orig [ID]   summarize in the session's own language, not English

Delete selection (combine freely; substring and -p narrow it further):
  --rm IDS          comma-separated session ids; confirms, then deletes
  --rm-all          every session the filters above select (needs --apply)
  --older-than N    sessions untouched for more than N days
  --max-turns N     sessions with N turns or fewer
  --apply           required by --older-than/--max-turns, which dry-run otherwise
  --yes, -y         skip the confirmation prompt (required when stdin is a pipe)
  --dry-run         report only, never delete
  --trash DIR       trash location (default: $HOME/.cache/ide-sessions-trash)

Deleted files move to the trash dir, so a mistake is recoverable.
The live session ($CLAUDE_CODE_SESSION_ID) is never deleted.
EOF
}

while [ $# -gt 0 ]; do
  case "$1" in
    -n) LIMIT="$2"; shift 2 ;;
    -f) FULL_PATH=1; shift ;;
    -p) PROJECT_SCOPE=1; shift ;;
    --rm) RM_IDS="$2"; shift 2 ;;
    --rm-all) RM_ALL=1; shift ;;
    --sum) SUM_ID="$2"; shift 2 ;;
    --sum-model) SUM_MODEL="$2"; shift 2 ;;
    --sum-gap) SUM_GAP="$2"; shift 2 ;;
    --sum-refresh) SUM_REFRESH=1; shift ;;
    --sum-raw) SUM_RAW=1; shift ;;
    # `--sum-orig <ID>` is the same request as `--sum <ID> --sum-orig`, and
    # typing both flags for one session is ceremony. A word after it that is
    # not itself a flag is the id.
    --sum-orig)
      SUM_LANG=orig; shift
      case "${1:-}" in ''|-*) ;; *) SUM_ID="$1"; shift ;; esac ;;
    --older-than) OLDER_THAN="$2"; shift 2 ;;
    --max-turns) MAX_TURNS="$2"; shift 2 ;;
    --trash) TRASH_ROOT="$2"; shift 2 ;;
    --apply) APPLY=1; shift ;;
    --yes|-y) ASSUME_YES=1; shift ;;
    --dry-run) DRY_RUN=1; shift ;;
    -h|--help) usage; exit 0 ;;
    -*) usage >&2; echo "unknown option: $1" >&2; exit 1 ;;
    *) FILTER="$1"; shift ;;
  esac
done

# --sum and --sum-orig answer the same question in two languages, so they cache
# side by side; one file would mean each flag silently discarding the other's
# work.
SUM_FILE_SUFFIX=""
[ "$SUM_LANG" = orig ] && SUM_FILE_SUFFIX=".orig"

# Every path a session id owns. Deleting only the transcript would leave the
# subagent logs, env, history and usage records behind as orphans.
footprint_of() {
  local sid="$1" transcript="$2" proj_dir
  proj_dir=$(dirname "$transcript")
  printf '%s\n' \
    "$transcript" \
    "$proj_dir/$sid" \
    "$CONFIG_DIR/file-history/$sid" \
    "$CONFIG_DIR/session-env/$sid" \
    "$CONFIG_DIR/usage-data/facets/$sid.json" \
    "$CONFIG_DIR/usage-data/session-meta/$sid.json" \
    "$CONFIG_DIR/security/security_warnings_state_$sid.json" \
    "$CONFIG_DIR/security/security_warnings_state_$sid.lock" \
    "$SUM_CACHE/claude-$sid.md" \
    "$SUM_CACHE/claude-$sid.orig.md"
}

# ── summary of one session ──────────────────────────────────────────────────
#
# A transcript is thousands of lines; what a person wants back a week later is
# four bullets. The work is split in two: a local pass that throws away
# everything a summary cannot use (tool output, hook chatter, slash-command
# plumbing), and one model call over what is left. Only the first pass knows
# this IDE's on-disk format — everything after it is the same in all three
# scripts.
#
# The summary comes back in English whatever language the session was held in,
# because that is what the prompt asks for; a purely local extraction could not
# translate, which is why a model is called at all. --sum-orig asks for the
# session's own language instead — same digest, one rule swapped.

# The digest. Reads the transcript, prints a compact per-topic block.
# Topics are cut where the work actually stopped: a silence longer than
# --sum-gap, or a change of working directory.
sum_digest() {
  python3 - "$1" "$SUM_GAP" <<'PY'
import json, re, sys, datetime

path, gap_min = sys.argv[1], int(sys.argv[2])
gap = gap_min * 60

# Slash commands, hook output and skill preambles are typed by the user but
# written by the machine. They say nothing about the work and would otherwise
# dominate a short session.
NOISE = ('<local-command-', '<command-name>', '<command-message>',
         '<command-args>', '<bash-input>', '<bash-stdout>', '<bash-stderr>',
         'Caveat: The messages below were generated',
         'Base directory for this skill:')
REMINDER = re.compile(r'<system-reminder>.*?</system-reminder>', re.S)

def clean(t):
    t = REMINDER.sub('', t or '').strip()
    for p in NOISE:
        if t.startswith(p):
            return ''
    return t

# ── redaction ───────────────────────────────────────────────────────────────
#
# A session can contain a credential: pasted into a prompt, echoed back in a
# reply, printed inside an error. The digest copies reply text, so without this
# a key would travel three ways at once — to whatever API summarizes (not
# necessarily the vendor the session itself ran on), into a cache file on disk,
# and onto the terminal of the session asking for the summary, which is itself
# being recorded.
#
# So masking happens here, before anything leaves the process, and --sum-raw
# shows exactly what would have been sent. Two tiers: a shape that can only be
# a token is masked anywhere, while a shape that merely could
# be one — 40 characters of base62, 32 of hex — is masked only where a
# credential word stands beside it. Otherwise every git SHA in the session
# would come back as <REDACTED>.
PROVIDER = re.compile(
    r'AKIA[0-9A-Z]{16}'
    r'|(?:ghp|gho|ghs|ghu|ghr)_[A-Za-z0-9]{36,}'
    r'|github_pat_[A-Za-z0-9_]{22,}'
    r'|glpat-[A-Za-z0-9_-]{20,}'
    r'|xox[baprs]-[A-Za-z0-9-]{10,}'
    r'|tvly-[A-Za-z0-9-]{10,}'
    r'|AIza[A-Za-z0-9_-]{35}'
    r'|(?:sk|rk)_live_[A-Za-z0-9]{20,}'
    r'|sk-(?:or-v1-|proj-|ant-)?[A-Za-z0-9-]{20,}'
    r'|ATATT[A-Za-z0-9_=.-]{20,}'
    r'|at-[A-Za-z0-9]{30,}'
    r'|hf_[A-Za-z0-9]{30,}'
    r'|dckr_pat_[A-Za-z0-9_-]{20,}'
    r'|eyJ[A-Za-z0-9_-]{10,}\.eyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]*'
    r'|-----BEGIN (?:RSA |EC |DSA |OPENSSH |PGP )?PRIVATE KEY-----')

# Credentials inside a URL. Separate from the list above so the scheme and host
# survive: postgres://admin:pw@db/app is worth reading as "postgres, db, app".
URL_CRED = re.compile(r'://[^/:@\s]+:([^/:@\s]{3,})@')

# A label and the value after it. The label is what a secret is called; the
# value is only required to be long, because its shape says nothing.
#
# Huawei Cloud and OpenStack are the reason this tier exists in this form. Their
# access key is 20 characters of upper case and digits and the secret 40 of
# base62 — the same shapes as a git SHA, a build id, half the identifiers in
# ordinary output — so no pattern can take them without masking everything. The
# variable name can, and it is right there on the line. Jira reaches here too
# when a token is passed as --token rather than carrying its ATATT prefix.
LABEL = (r'(?:--?)?(?:pass|passwd|password|passphrase|pass-phrase'
         r'|token|secret|api[-_]?key|apikey|auth[-_]?token|access[-_]?key'
         r'|secret[-_]?key|client[-_]?secret|private[-_]?key|credential'
         r'|jira[-_]?(?:api[-_]?)?token'
         r'|hw[-_]?(?:access|secret)(?:[-_]?key)?'
         r'|huaweicloud?[-_]?[a-z_]*key'
         r'|os[-_](?:access|secret)[-_]?key'
         # …_AK and …_SK: Huawei's own SDKs spell the pair that way, and the
         # value carries no prefix at all, so the suffix is the whole signal.
         r'|(?:hw|huawei|huaweicloud|obs|os)[-_][a-z_0-9]*[-_]?[as]k)s?[A-Z0-9_]*')
VALUE = r'[A-Za-z0-9+/=_.~-]{16,}'

# Assignment first — NAME=value, NAME: value, Authorization: Bearer value —
# then the flag form, --pass value. Both keep the label readable: a summary that
# hides which credential was involved answers nothing.
NAMED = re.compile(r'(%s)(\s*[=:]\s*(?:Bearer\s+)?)([\'"]?)(%s)' % (LABEL, VALUE), re.I)
FLAGGED = re.compile(r'(%s)(\s+)([\'"]?)(%s)' % (LABEL, VALUE), re.I)

# A line that talks about credentials at all. Only there is a long anonymous
# run treated as a secret.
CRED_WORD = re.compile(
    r'token|secret|password|passwd|credential|api[ _-]?key|access[ _-]?key'
    r'|huawei|openstack|jira|токен|пароль|секрет|ключ', re.I)
HIGH_ENTROPY = re.compile(r'\b[A-Za-z0-9_-]{40,}\b|\b[A-Fa-f0-9]{32,}\b')

def mask(m):
    return '<REDACTED:%d>' % len(m.group(0))

def redact(text):
    out = []
    for line in (text or '').splitlines():
        line = PROVIDER.sub(mask, line)
        line = URL_CRED.sub(
            lambda m: '://<REDACTED:%d>@' % len(m.group(1)), line)
        # A value already masked is left alone: masking the marker again would
        # overwrite the real length with the marker's own.
        for pat in (NAMED, FLAGGED):
            line = pat.sub(
                lambda m: m.group(0) if m.group(4).startswith('<REDACTED:')
                else '%s%s%s<REDACTED:%d>' % (m.group(1), m.group(2),
                                              m.group(3), len(m.group(4))),
                line)
        if CRED_WORD.search(line):
            line = HIGH_ENTROPY.sub(mask, line)
        out.append(line)
    return '\n'.join(out)

turns = []
with open(path, errors='replace') as fh:
    for line in fh:
        try:
            d = json.loads(line)
        except ValueError:
            continue
        if d.get('type') not in ('user', 'assistant') or d.get('isSidechain'):
            continue
        try:
            ep = datetime.datetime.fromisoformat(
                (d.get('timestamp') or '').replace('Z', '+00:00')).timestamp()
        except ValueError:
            ep = 0.0
        content = (d.get('message') or {}).get('content')
        text, tools = [], []
        if isinstance(content, str):
            text.append(content)
        elif isinstance(content, list):
            for b in content:
                if not isinstance(b, dict):
                    continue
                if b.get('type') == 'text':
                    text.append(b.get('text', ''))
                elif b.get('type') == 'tool_use':
                    tools.append(b.get('name', '?'))
        txt = redact(clean('\n'.join(x for x in text if x)))
        if not txt and not tools:
            continue
        turns.append({'ep': ep, 'role': d['type'], 'txt': txt,
                      'tools': tools, 'cwd': d.get('cwd') or ''})

if not turns:
    sys.exit(3)

# ── segment ─────────────────────────────────────────────────────────────────
segments, cur, last_ep, last_cwd = [], [], None, None
for t in turns:
    boundary = (last_ep is not None and t['ep'] and t['ep'] - last_ep > gap) or \
               (t['cwd'] and last_cwd and t['cwd'] != last_cwd)
    if boundary and cur:
        segments.append(cur)
        cur = []
    cur.append(t)
    last_ep = t['ep'] or last_ep
    last_cwd = t['cwd'] or last_cwd
if cur:
    segments.append(cur)

def when(ep):
    return datetime.datetime.fromtimestamp(ep).strftime('%Y-%m-%d %H:%M') if ep else '?'

def cut(s, n):
    s = ' '.join(s.split())
    return s if len(s) <= n else s[:n - 1] + '…'

# Both ends of a segment carry meaning — the ask at the start, the outcome at
# the end. The middle is where repetition lives, so that is what is dropped.
def sample(items, keep):
    if len(items) <= keep:
        return items
    head = keep // 2
    return items[:head] + items[-(keep - head):]

out = []
for i, seg in enumerate(segments, 1):
    users = [t for t in seg if t['role'] == 'user' and t['txt']]
    bots = [t for t in seg if t['role'] == 'assistant' and t['txt']]
    tools = {}
    for t in seg:
        for name in t['tools']:
            tools[name] = tools.get(name, 0) + 1
    cwd = next((t['cwd'] for t in seg if t['cwd']), '?')
    out.append('## part %d — %s — %s → %s — %d turns'
               % (i, cwd, when(seg[0]['ep']), when(seg[-1]['ep']), len(seg)))
    for t in sample(users, 8):
        out.append('ASKED: ' + cut(t['txt'], 400))
    for t in sample(bots, 4):
        out.append('REPLIED: ' + cut(t['txt'], 220))
    if tools:
        top = sorted(tools.items(), key=lambda kv: -kv[1])[:8]
        out.append('TOOLS: ' + ', '.join('%s x%d' % (k, v) for k, v in top))
    out.append('')

print('\n'.join(out))
PY
}

# The language rule is the whole difference between --sum and --sum-orig, so it
# is one variable inside one prompt. Two separate prompts would drift apart at
# the first edit to everything they have in common.
if [ "$SUM_LANG" = orig ]; then
  SUM_LANG_RULE='- Write in the language the session itself was held in. Where more than one was
  used, take the language the user typed most, and use only that one — do not
  mix two languages in a summary and do not translate into English.'
else
  SUM_LANG_RULE='- Write in English only. One session can mix languages — Russian, German, any
  other, sometimes inside a single sentence. Translate all of it; never leave a
  phrase in the original language and never answer in it.'
fi

# What the model is asked for. Kept next to the digest so the two are read
# together: the digest decides what the model can see, this decides what it
# does with it.
SUM_PROMPT="Below is a machine-made digest of one AI coding session: the user's asks, short excerpts of the replies, and tool counts, already split into parts.

Write a summary of what was DONE in that session.

Rules:
$SUM_LANG_RULE
- Keep verbatim, untranslated: code, file paths, commands, flags, identifiers,
  branch names, error strings.
- Never write out a key, token, password or other credential, even if one
  appears in the digest. Anything already masked as <REDACTED:N> stays masked;
  say what it was for, not what it was.
- One '### ' heading per distinct topic, 4-8 words, naming the actual subject.
- Under each heading, 2-4 bullets. A bullet is <= 14 words, past tense, and names
  something concrete: a file, a command, a tool, a decision, a number.
- Merge parts that are the same topic. At most 5 headings for the whole session.
- Say what was decided or found, not what was discussed.
- No preamble, no closing remarks, no restating these rules."

# Model choice, in order: what the user asked for, then the cheapest priced
# model of this IDE's provider found in a models.dev catalogue already on disk,
# then the CLI's own alias for its small model. No model name or version is
# pinned in this file — a new cheap model is picked up as soon as the catalogue
# on disk knows about it.
sum_pick_model() {
  [ -n "$SUM_MODEL" ] && { printf '%s' "$SUM_MODEL"; return; }
  local cat picked
  for cat in "${IDE_SESSIONS_MODELS_JSON:-}" \
             "$HOME/.cache/ide-sessions/models.dev.json" \
             "$HOME/.cache/opencode/models.json"; do
    [ -n "$cat" ] && [ -f "$cat" ] || continue
    picked=$(python3 - "$cat" anthropic <<'PY' 2>/dev/null || true
import json, sys
try:
    db = json.load(open(sys.argv[1]))
    models = db[sys.argv[2]]['models']
except Exception:
    sys.exit(1)
best = None
for mid, m in models.items():
    cost = (m.get('cost') or {}).get('input')
    ctx = (m.get('limit') or {}).get('context') or 0
    # A zero price means "not priced here" (promo, subscription) far more often
    # than "free", and picking one on that basis is how a summary silently
    # lands on a model nobody meant to use.
    if not cost or cost <= 0 or ctx < 100000:
        continue
    if best is None or cost < best[0]:
        best = (cost, mid)
print(best[1] if best else '')
PY
)
    [ -n "$picked" ] && { printf '%s' "$picked"; return; }
  done
  printf 'haiku'
}

# A summary of a long session is one model call and takes as long as it takes —
# 79 seconds for a ten-part digest, measured. A terminal with nothing on it for
# that long reads as a hang, so say what is happening and count the seconds.
#
# Only when stderr is a terminal: in a pipe or a script the carriage returns
# would end up in a file, and the summary on stdout has to stay clean either
# way.
SUM_PROGRESS_PID=""
sum_progress_start() {
  [ -t 2 ] || return 0
  local msg="$1"
  (
    i=0
    while :; do
      printf '\r  %s… %ds' "$msg" "$i" >&2
      i=$((i + 1))
      sleep 1
    done
  ) &
  SUM_PROGRESS_PID=$!
}

sum_progress_stop() {
  [ -n "$SUM_PROGRESS_PID" ] || return 0
  kill "$SUM_PROGRESS_PID" 2>/dev/null || true
  wait "$SUM_PROGRESS_PID" 2>/dev/null || true
  SUM_PROGRESS_PID=""
  # \033[K clears what the counter left on the line; without it the next
  # output lands on top of half a progress line.
  printf '\r\033[K' >&2
}

# An interrupted run must not leave the counter running in the background.
trap 'sum_progress_stop' EXIT INT TERM

if [ -n "$SUM_ID" ]; then
  transcript=$(find "$PROJECTS_DIR" -maxdepth 2 -name "$SUM_ID.jsonl" -print -quit 2>/dev/null || true)
  if [ -z "$transcript" ]; then
    echo "No transcript for session $SUM_ID under $PROJECTS_DIR" >&2
    echo "List the ids with: claude-sessions" >&2
    exit 1
  fi

  if [ "$SUM_RAW" = 1 ]; then
    sum_digest "$transcript" || {
      echo "Nothing to summarize: $SUM_ID has no user or assistant turns." >&2
      exit 1
    }
    exit 0
  fi

  model=$(sum_pick_model)
  src_mtime=$(stat -c %Y "$transcript" 2>/dev/null || echo 0)
  key="ide-sessions-sum v1 src=$src_mtime model=$model gap=$SUM_GAP lang=$SUM_LANG"
  cache_file="$SUM_CACHE/claude-$SUM_ID$SUM_FILE_SUFFIX.md"

  # The cache is keyed by the transcript's mtime, so a session that has since
  # been resumed re-summarizes itself and one that has not costs nothing twice.
  # Checked before the digest is built, not after: parsing a 9 MB transcript
  # takes about 0.6 s, and doing it to then throw the result away was most of
  # what a cache hit cost.
  if [ "$SUM_REFRESH" != 1 ] && [ -f "$cache_file" ] &&
     [ "$(head -1 "$cache_file")" = "<!-- $key -->" ]; then
    tail -n +2 "$cache_file"
    exit 0
  fi

  digest=$(sum_digest "$transcript") || {
    echo "Nothing to summarize: $SUM_ID has no user or assistant turns." >&2
    exit 1
  }

  command -v claude >/dev/null 2>&1 || {
    echo "claude CLI not found — needed to write the summary." >&2
    echo "Use --sum-raw for the extracted digest without a model." >&2
    exit 1
  }

  # --setting-sources '' and an empty MCP config are not tidiness: with the
  # user's CLAUDE.md, skills and MCP servers loaded, the same one-line prompt
  # measured 40 179 input tokens against 4 591 without them.
  # Summarizing writes a session of its own — `claude -p` is a session like any
  # other. Left alone, every --sum added a row to the very listing this script
  # exists to keep readable, and two summaries in a row looked like the tool
  # breeding sessions.
  #
  # The id is chosen here rather than read back afterwards, so the cleanup knows
  # what to remove even when the call fails or is interrupted.
  scratch_id=$(python3 -c 'import uuid; print(uuid.uuid4())')

  sum_scratch_remove() {
    local sid="$1" path
    [ -n "$sid" ] || return 0
    path=$(find "$PROJECTS_DIR" -maxdepth 2 -name "$sid.jsonl" -print -quit 2>/dev/null || true)
    [ -n "$path" ] || return 0
    footprint_of "$sid" "$path" | while IFS= read -r p; do
      if [ -e "$p" ]; then rm -rf "$p"; fi
    done
  }

  # An interrupted summary must not leave its scratch session behind either.
  trap 'sum_progress_stop; sum_scratch_remove "$scratch_id"' EXIT INT TERM

  sum_progress_start "summarizing $(printf '%s\n' "$digest" | grep -c '^## part') part(s) with $model"

  summary=$(printf '%s\n\n%s\n' "$SUM_PROMPT" "$digest" |
    claude -p \
      --model "$model" \
      --session-id "$scratch_id" \
      --setting-sources '' \
      --strict-mcp-config --mcp-config '{"mcpServers":{}}' \
      --disable-slash-commands \
      --disallowedTools "Bash Edit Write Read Glob Grep WebFetch WebSearch Agent Task" \
      2>/dev/null) || summary=""
  sum_progress_stop
  sum_scratch_remove "$scratch_id"

  # A model name from a catalogue can be one this account cannot call. Rather
  # than fail, fall back to whatever model the CLI would have chosen itself.
  if [ -z "$summary" ] && [ -z "$SUM_MODEL" ]; then
    scratch_id=$(python3 -c 'import uuid; print(uuid.uuid4())')
    sum_progress_start "retrying with the model the CLI picks itself"
    summary=$(printf '%s\n\n%s\n' "$SUM_PROMPT" "$digest" |
      claude -p \
        --session-id "$scratch_id" \
        --setting-sources '' \
        --strict-mcp-config --mcp-config '{"mcpServers":{}}' \
        --disable-slash-commands \
        --disallowedTools "Bash Edit Write Read Glob Grep WebFetch WebSearch Agent Task" \
        2>/dev/null) || summary=""
    sum_progress_stop
    sum_scratch_remove "$scratch_id"
    model="(CLI default)"
  fi

  if [ -z "$summary" ]; then
    echo "The model returned nothing. Re-run with --sum-raw to see the digest." >&2
    exit 1
  fi

  # A summary can still name what a secret was for, and it is written without
  # being read again. Keep it to this user: 0700 on the directory, 0600 on the
  # file, set before the content goes in.
  mkdir -p "$SUM_CACHE"
  chmod 700 "$SUM_CACHE" 2>/dev/null || true
  : > "$cache_file"
  chmod 600 "$cache_file" 2>/dev/null || true
  { printf '<!-- %s -->\n' "$key"; printf '%s\n' "$summary"; } > "$cache_file"
  # Which model wrote this goes to stderr, so `--sum | …` stays pure summary.
  echo "summarized with $model" >&2
  printf '%s\n' "$summary"
  exit 0
fi

DELETE_MODE=0
[ -n "$RM_IDS$OLDER_THAN$MAX_TURNS" ] && DELETE_MODE=1
[ "$RM_ALL" = 1 ] && DELETE_MODE=1

# An explicit id list is intent enough to delete after a prompt. Bulk criteria
# can sweep up far more than intended, so they stay dry-run until --apply.
BULK=0
[ -n "$OLDER_THAN$MAX_TURNS" ] && BULK=1
# --rm-all is the widest selection there is, so it dry-runs like the rest.
[ "$RM_ALL" = 1 ] && BULK=1

for n in "$OLDER_THAN" "$MAX_TURNS"; do
  case "$n" in
    '') ;;
    *[!0-9]*) echo "--older-than/--max-turns want a plain number, got: $n" >&2; exit 1 ;;
  esac
done

CURRENT_ID="${CLAUDE_CODE_SESSION_ID:-}"

SCAN_DIR="$PROJECTS_DIR"
SCAN_DEPTH=2
if [ "$PROJECT_SCOPE" = 1 ]; then
  SCAN_DIR="$PROJECTS_DIR/$(pwd | sed -E 's/[^a-zA-Z0-9]/-/g')"
  SCAN_DEPTH=1
fi

# Collect: mtime_epoch \t session_id \t cwd \t turns \t transcript_path
tmpfile=$(mktemp)
trap 'rm -f "$tmpfile"' EXIT

find "$SCAN_DIR" -maxdepth "$SCAN_DEPTH" -name "*.jsonl" -print0 2>/dev/null | while IFS= read -r -d '' f; do
  mtime=$(stat -c %Y "$f" 2>/dev/null || echo 0)
  [ "$mtime" = 0 ] && continue
  sid=$(basename "$f" .jsonl)
  cwd=$( (grep -m1 -o '"cwd":"[^"]*"' "$f" || true) 2>/dev/null | head -1 | sed -E 's/"cwd":"(.*)"/\1/')
  [ -z "$cwd" ] && cwd="(unknown)"
  turns=$(wc -l < "$f" 2>/dev/null | tr -d ' ')
  printf '%s\t%s\t%s\t%s\t%s\n' "$mtime" "$sid" "$cwd" "$turns" "$f" >> "$tmpfile"
done

now=$(date +%s)

format_age() {
  local d=$(( now - $1 ))
  if [ "$d" -lt 60 ]; then echo "${d}s ago"
  elif [ "$d" -lt 3600 ]; then echo "$(( d/60 ))m ago"
  elif [ "$d" -lt 86400 ]; then echo "$(( d/3600 ))h ago"
  else echo "$(( d/86400 ))d ago"
  fi
}

shorten_dir() {
  local p="$1"
  [ "$FULL_PATH" = 1 ] && { echo "$p"; return; }
  echo "$p" | awk -F/ '{ n=NF; if (n<=3) print $0; else print $(n-2)"/"$(n-1)"/"$n }'
}

rows=$(sort -t $'\t' -k1,1nr "$tmpfile")
[ -n "$FILTER" ] && rows=$(echo "$rows" | grep -F "$FILTER" || true)
[ "$LIMIT" != 0 ] && rows=$(echo "$rows" | head -n "$LIMIT")


if [ "$DELETE_MODE" = 1 ]; then
  candidates=$(printf '%s\n' "$rows" | awk -F'\t' \
      -v ids="$RM_IDS" -v older="$OLDER_THAN" -v maxt="$MAX_TURNS" -v all="$RM_ALL" \
      -v now="$now" -v cur="$CURRENT_ID" '
    BEGIN {
      n = split(ids, a, ",")
      nwant = 0
      for (i = 1; i <= n; i++) {
        gsub(/^[ \t]+|[ \t]+$/, "", a[i])
        if (a[i] != "") { want[a[i]] = 1; nwant++ }
      }
    }
    $2 == "" { next }
    {
      if ($2 == cur) next
      if (all != 1 && nwant > 0 && !($2 in want)) next
      if (older != "" && (now - $1) < older * 86400) next
      if (maxt != "" && $4 + 0 > maxt + 0) next
      print
    }
  ')

  if [ -z "$candidates" ]; then
    echo "No sessions match. Nothing to delete."
    [ -n "$RM_IDS" ] && echo "(the live session is always excluded; check the id with: claude-sessions)"
    exit 0
  fi

  # Resolve the real footprint, so the report counts only paths that exist.
  paths_file=$(mktemp)
  trap 'rm -f "$tmpfile" "$paths_file"' EXIT

  echo "Sessions selected for deletion:"
  echo
  printf "%-36s %-10s %-6s %-11s %s\n" "SESSION ID" "LAST" "TURNS" "DATE" "DIR"
  count=0
  while IFS=$'\t' read -r mtime sid cwd turns fpath; do
    [ -z "$sid" ] && continue
    count=$(( count + 1 ))
    date_str=$(date -d "@$mtime" +"%m-%d %H:%M" 2>/dev/null || date -r "$mtime" +"%m-%d %H:%M")
    printf "%-36s %-10s %-6s %-11s %s\n" \
      "$sid" "$(format_age "$mtime")" "$turns" "$date_str" "$(shorten_dir "$cwd")"
    # 'if' rather than '&&': a false test as the loop's last command would make
    # the loop exit non-zero and set -e would kill the script mid-report.
    footprint_of "$sid" "$fpath" | while IFS= read -r p; do
      if [ -e "$p" ]; then printf '%s\n' "$p"; fi
    done >> "$paths_file"
  done <<< "$candidates"

  npaths=$(wc -l < "$paths_file" | tr -d ' ')
  # NUL-separated so paths containing spaces are measured correctly.
  total=$(tr '\n' '\0' < "$paths_file" | du -scb --files0-from=- 2>/dev/null | tail -1 | cut -f1)
  [ -n "$total" ] || total=0
  human=$(numfmt --to=iec --suffix=B "$total" 2>/dev/null || echo "${total}B")

  echo
  echo "$count session(s), $npaths path(s), $human total."

  if [ "$DRY_RUN" = 1 ] || { [ "$BULK" = 1 ] && [ "$APPLY" != 1 ]; }; then
    echo
    echo "Dry run. Nothing deleted."
    if [ "$DRY_RUN" != 1 ]; then
      echo "To delete: re-run the same command with --apply"
    fi
    exit 0
  fi

  if [ "$ASSUME_YES" != 1 ]; then
    if [ ! -t 0 ]; then
      echo "Refusing to delete unattended: pass --yes when stdin is not a terminal." >&2
      exit 1
    fi
    printf 'Delete these %s session(s)? [y/N] ' "$count"
    read -r reply
    case "$reply" in
      y|Y|yes|YES) ;;
      *) echo "Aborted."; exit 1 ;;
    esac
  fi

  # Move, don't unlink: the trash mirrors absolute paths so a restore is a plain copy.
  stamp=$(date +%Y%m%d-%H%M%S)
  trash="$TRASH_ROOT/claude-$stamp"
  mkdir -p "$trash"

  moved=0
  while IFS= read -r p; do
    [ -e "$p" ] || continue
    dest="$trash/${p#/}"
    mkdir -p "$(dirname "$dest")"
    if mv "$p" "$dest" 2>/dev/null; then
      moved=$(( moved + 1 ))
    else
      echo "  ! could not move $p" >&2
    fi
  done < "$paths_file"

  printf '%s\n' "$candidates" | cut -f2 > "$trash/.session-ids"

  echo
  echo "Deleted $count session(s): $moved path(s) moved to"
  echo "  $trash"
  echo
  echo "Restore everything:  cp -a $trash/* /"
  echo "Free the space:       delete that trash dir once you are sure"
  exit 0
fi

printf "%-3s %-36s %-10s %-6s %-11s %s\n" "" "SESSION ID (full)" "LAST" "TURNS" "DATE" "DIR"

while IFS=$'\t' read -r mtime sid cwd turns fpath; do
  [ -z "$sid" ] && continue
  mark=" "
  [ "$sid" = "$CURRENT_ID" ] && mark="*"
  age=$(format_age "$mtime")
  date_str=$(date -d "@$mtime" +"%m-%d %H:%M" 2>/dev/null || date -r "$mtime" +"%m-%d %H:%M")
  dir_disp=$(shorten_dir "$cwd")
  printf "%-3s %-36s %-10s %-6s %-11s %s\n" "$mark" "$sid" "$age" "$turns" "$date_str" "$dir_disp"
done <<< "$rows"

echo
echo "Resume: cd <DIR> && claude --resume <SESSION ID>"
echo "Fork:   cd <DIR> && claude --resume <SESSION ID> --fork-session   (new session id, original untouched)"
echo "Delete: claude-sessions --rm <SESSION ID>            (asks to confirm; --dry-run to preview)"
