#!/usr/bin/env bash
# claude-sessions: list Claude Code sessions across ALL projects with their
# bound cwd + last-activity time, sorted newest-first.
#
# Why this exists: Claude Code's project-hash (and thus --resume/-c lookup
# scope) is fixed to whatever cwd was active when `claude` was launched, and
# never changes afterward even if you `cd` inside the running session's Bash
# tool. That mismatch between "where I think I am" and "what dir a session
# is actually filed under" is easy to lose track of (confirmed the hard way:
# a session launched from ap-southeast-2/cluster-a silently carried a whole
# day's us-east-1 work because nobody ever exited/relaunched claude). This
# script surfaces id + real bound dir + recency so that's visible up front,
# instead of discovered after the fact by grepping raw .jsonl.
#
# Usage:
#   claude-sessions              # all sessions, newest first
#   claude-sessions -n 20        # limit to 20 rows
#   claude-sessions <substring>  # filter by dir substring
#   claude-sessions -f           # show full dir path instead of last 3 components
#
# Deleting:
#   claude-sessions --rm <ID>[,<ID>...]        # asks to confirm, then deletes
#   claude-sessions --older-than 30            # bulk: dry-run, needs --apply
#   claude-sessions --max-turns 2              # bulk: dry-run, needs --apply
#   claude-sessions --older-than 30 --apply
#
# Naming an id is intent enough, so --rm confirms and deletes. Bulk criteria can
# match far more than expected, so they print a dry-run until --apply is passed.
#
# A session is not just its transcript: subagent logs, file-history, session-env,
# usage-data and security state are all keyed by session id. Delete removes the
# whole footprint, moving it to a trash dir rather than unlinking, so a mistake
# stays recoverable.

set -euo pipefail

CONFIG_DIR="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
PROJECTS_DIR="$CONFIG_DIR/projects"
TRASH_ROOT="${IDE_SESSIONS_TRASH:-$HOME/.cache/ide-sessions-trash}"
SUM_CACHE="${IDE_SESSIONS_SUM_CACHE:-$HOME/.cache/ide-sessions-summaries}"
LIMIT=0
FILTER=""
FULL_PATH=0
PROJECT_SCOPE=0
RM_IDS=""
RM_ALL=0
EVERYWHERE=0
OLDER_THAN=""
MAX_TURNS=""
ABOUT_MIN=500
SEARCH=""
MIN_HITS=1
APPLY=0
ASSUME_YES=0
DRY_RUN=0
SUM_ID=""
LIST_MODELS=0
SUM_MODEL="${IDE_SESSIONS_SUM_MODEL:-}"
SUM_GAP=45
SUM_REFRESH=0
SUM_RAW=0
SUM_LANG=en

usage() {
  cat <<'EOF'
Usage: claude-sessions [-n LIMIT] [-f] [-p] [substring]
       claude-sessions --search REGEX [--min-hits N]
       claude-sessions --sum <ID>
       claude-sessions --sum-orig <ID>
       claude-sessions --rm <ID>[,<ID>...]
       claude-sessions -p --rm-all --apply
       claude-sessions --older-than DAYS | --max-turns N --apply

  -n LIMIT          limit rows
  -f                full dir path instead of last 3 components
  -p                scope to the exact project-hash dir for $PWD (like 'rtk gain -p')
  substring         filter by dir substring
  --about-min N     ABOUT column for sessions of N turns or more: the last
                    commit and the last files edited (default: 500)

Search (needs ripgrep):
  --search REGEX    only sessions that mention REGEX — Python syntax, any case,
                    ^ and $ at every line. HITS counts the matches in your
                    prompts / the model's replies / its tools (calls and output);
                    rows with the most in your prompts come first. Injected
                    instructions and reminders are not searched.
  --min-hits N      only sessions with N hits or more in total (default: 1)

What the search shows:

  claude-sessions --search nginx                      LISTS the sessions that mention nginx, with HITS
  claude-sessions --search nginx -n 10                the 10 with the most hits in your prompts
  claude-sessions --search nginx --min-hits 20        only sessions with 20 hits or more in total
  claude-sessions -p --search nginx                   this project's sessions only
  claude-sessions k8s --search nginx                  only in directories matching "k8s"
  claude-sessions --search 'fluent-?bit|fluentd'      fluentbit, fluent-bit or fluentd
  claude-sessions --search '^\s*server_name'          lines that start with server_name
  claude-sessions --search 'proxy_pass\s+https?://'   a regex: proxy_pass, spaces, a URL

  HITS 21/217/1444 = 21 matches in your prompts, 217 in the model's replies,
  1444 in its tool calls and their output. Search never deletes anything.

Summary of one session, grouped by topic (English unless --sum-orig):
  --sum ID          summarize that session; the result is cached per transcript
  --sum-model M     model to summarize with (default: cheapest one available)
  --list-models     the names --sum-model accepts, and the one --sum uses by default
  --sum-gap MIN     minutes of silence that start a new topic (default: 45)
  --sum-refresh     ignore the cached summary and ask the model again
  --sum-raw         print the extracted digest only — no model call, no cost
  --sum-orig [ID]   summarize in the session's own language, not English

Delete selection (combine freely; substring and -p narrow it further):
  --rm IDS          comma-separated session ids; confirms, then deletes
  --rm-all          every session the current filters select — see below
  --everywhere      the only way to run --rm-all with no scope at all
  --older-than N    sessions untouched for more than N days
  --max-turns N     sessions with N turns or fewer
  --apply           required by --older-than/--max-turns, which dry-run otherwise
  --yes, -y         skip the confirmation prompt (required when stdin is a pipe)
  --dry-run         report only, never delete
  --trash DIR       trash location (default: $HOME/.cache/ide-sessions-trash)

What deletes what. The scope comes from the same flags as the listing, and
nothing goes until --apply — without it you get the list and a dry-run note.

  claude-sessions -p                          lists this project's sessions
  claude-sessions -p --rm-all                 lists what --apply would delete, deletes nothing

  claude-sessions --sum <ID>                                    SUMMARIZES the session in English, default model
  claude-sessions --sum <ID> --sum-model claude-haiku-4-5       SUMMARIZES it in English with claude-haiku-4-5
  claude-sessions --sum-orig <ID> --sum-model claude-haiku-4-5  SUMMARIZES it in its own language with claude-haiku-4-5
  claude-sessions --sum <ID> --sum-raw                          prints the digest only — no model call, no cost
  claude-sessions --list-models                                 lists the names --sum-model accepts
  Each SUMMARIZES is one model call; the result is cached, --sum-refresh asks again.

  claude-sessions -p --rm-all --apply         DELETES every session of this project
  claude-sessions k8s --rm-all --apply        DELETES every session whose dir matches "k8s"
  claude-sessions -p --older-than 30 --apply  DELETES this project's sessions untouched for 30+ days
  claude-sessions -p --max-turns 20 --apply   DELETES this project's sessions of 20 turns or fewer
  claude-sessions --max-turns 2 --apply       DELETES sessions of 2 turns or fewer, in every project

  claude-sessions --rm-all                    refused: nothing narrows it
  claude-sessions --rm-all --everywhere       lists every project; add --apply to DELETE all of it

Deleted files move to the trash dir, so a mistake is recoverable.
The live session ($CLAUDE_CODE_SESSION_ID) is never deleted.
EOF
}

while [ $# -gt 0 ]; do
  case "$1" in
    -n) LIMIT="$2"; shift 2 ;;
    -f) FULL_PATH=1; shift ;;
    -p) PROJECT_SCOPE=1; shift ;;
    --rm) RM_IDS="$2"; shift 2 ;;
    --rm-all) RM_ALL=1; shift ;;
    --everywhere) EVERYWHERE=1; shift ;;
    --sum) SUM_ID="$2"; shift 2 ;;
    --sum-model) SUM_MODEL="$2"; shift 2 ;;
    --list-models|--list-model) LIST_MODELS=1; shift ;;
    --sum-gap) SUM_GAP="$2"; shift 2 ;;
    --sum-refresh) SUM_REFRESH=1; shift ;;
    --sum-raw) SUM_RAW=1; shift ;;
    # `--sum-orig <ID>` is the same request as `--sum <ID> --sum-orig`, and
    # typing both flags for one session is ceremony. A word after it that is
    # not itself a flag is the id.
    --sum-orig)
      SUM_LANG=orig; shift
      case "${1:-}" in ''|-*) ;; *) SUM_ID="$1"; shift ;; esac ;;
    --older-than) OLDER_THAN="$2"; shift 2 ;;
    --max-turns) MAX_TURNS="$2"; shift 2 ;;
    --about-min) ABOUT_MIN="${2:-}"; shift; [ $# -gt 0 ] && shift ;;
    --search) [ -n "${2:-}" ] || { echo "--search needs a pattern" >&2; exit 1; }
              SEARCH="$2"; shift 2 ;;
    --min-hits) MIN_HITS="${2:-}"; shift; [ $# -gt 0 ] && shift ;;
    --trash) TRASH_ROOT="$2"; shift 2 ;;
    --apply) APPLY=1; shift ;;
    --yes|-y) ASSUME_YES=1; shift ;;
    --dry-run) DRY_RUN=1; shift ;;
    -h|--help) usage; exit 0 ;;
    -*) usage >&2; echo "unknown option: $1" >&2; exit 1 ;;
    *) FILTER="$1"; shift ;;
  esac
done

# --sum and --sum-orig answer the same question in two languages, so they cache
# side by side; one file would mean each flag silently discarding the other's
# work.
SUM_FILE_SUFFIX=""
[ "$SUM_LANG" = orig ] && SUM_FILE_SUFFIX=".orig"

# Every path a session id owns. Deleting only the transcript would leave the
# subagent logs, env, history and usage records behind as orphans.
footprint_of() {
  local sid="$1" transcript="$2" proj_dir
  proj_dir=$(dirname "$transcript")
  printf '%s\n' \
    "$transcript" \
    "$proj_dir/$sid" \
    "$CONFIG_DIR/file-history/$sid" \
    "$CONFIG_DIR/session-env/$sid" \
    "$CONFIG_DIR/usage-data/facets/$sid.json" \
    "$CONFIG_DIR/usage-data/session-meta/$sid.json" \
    "$CONFIG_DIR/security/security_warnings_state_$sid.json" \
    "$CONFIG_DIR/security/security_warnings_state_$sid.lock" \
    "$SUM_CACHE/claude-$sid.md" \
    "$SUM_CACHE/claude-$sid.orig.md"
}

# ── summary of one session ──────────────────────────────────────────────────
#
# A transcript is thousands of lines; what a person wants back a week later is
# four bullets. The work is split in two: a local pass that throws away
# everything a summary cannot use (tool output, hook chatter, slash-command
# plumbing), and one model call over what is left. Only the first pass knows
# this IDE's on-disk format — everything after it is the same in all three
# scripts.
#
# The summary comes back in English whatever language the session was held in,
# because that is what the prompt asks for; a purely local extraction could not
# translate, which is why a model is called at all. --sum-orig asks for the
# session's own language instead — same digest, one rule swapped.

# The digest. Reads the transcript, prints a compact per-topic block.
# Topics are cut where the work actually stopped: a silence longer than
# --sum-gap, or a change of working directory.
sum_digest() {
  python3 - "$1" "$SUM_GAP" "${@:2}" <<'PY'
import json, re, sys, datetime

path, gap_min = sys.argv[1], int(sys.argv[2])
gap = gap_min * 60

# Slash commands, hook output and skill preambles are typed by the user but
# written by the machine. They say nothing about the work and would otherwise
# dominate a short session.
NOISE = ('<local-command-', '<command-name>', '<command-message>',
         '<command-args>', '<bash-input>', '<bash-stdout>', '<bash-stderr>',
         'Caveat: The messages below were generated',
         'Base directory for this skill:')
REMINDER = re.compile(r'<system-reminder>.*?</system-reminder>', re.S)

def clean(t):
    t = REMINDER.sub('', t or '').strip()
    for p in NOISE:
        if t.startswith(p):
            return ''
    return t

# ── redaction ───────────────────────────────────────────────────────────────
#
# A session can contain a credential: pasted into a prompt, echoed back in a
# reply, printed inside an error. The digest copies reply text, so without this
# a key would travel three ways at once — to whatever API summarizes (not
# necessarily the vendor the session itself ran on), into a cache file on disk,
# and onto the terminal of the session asking for the summary, which is itself
# being recorded.
#
# So masking happens here, before anything leaves the process, and --sum-raw
# shows exactly what would have been sent. Two tiers: a shape that can only be
# a token is masked anywhere, while a shape that merely could
# be one — 40 characters of base62, 32 of hex — is masked only where a
# credential word stands beside it. Otherwise every git SHA in the session
# would come back as <REDACTED>.
PROVIDER = re.compile(
    r'AKIA[0-9A-Z]{16}'
    r'|(?:ghp|gho|ghs|ghu|ghr)_[A-Za-z0-9]{36,}'
    r'|github_pat_[A-Za-z0-9_]{22,}'
    r'|glpat-[A-Za-z0-9_-]{20,}'
    r'|xox[baprs]-[A-Za-z0-9-]{10,}'
    r'|tvly-[A-Za-z0-9-]{10,}'
    r'|AIza[A-Za-z0-9_-]{35}'
    r'|(?:sk|rk)_live_[A-Za-z0-9]{20,}'
    r'|sk-(?:or-v1-|proj-|ant-)?[A-Za-z0-9_-]{20,}'
    r'|ATATT[A-Za-z0-9_=.-]{20,}'
    r'|at-[A-Za-z0-9]{30,}'
    r'|hf_[A-Za-z0-9]{30,}'
    r'|dckr_pat_[A-Za-z0-9_-]{20,}'
    r'|eyJ[A-Za-z0-9_-]{10,}\.eyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]*'
    r'|-----BEGIN (?:RSA |EC |DSA |OPENSSH |PGP )?PRIVATE KEY-----')

# Credentials inside a URL. Separate from the list above so the scheme and host
# survive: postgres://admin:pw@db/app is worth reading as "postgres, db, app".
# The password runs to the first @, not to the first slash: a generated
# password holds a / as often as any other symbol, and stopping there let the
# rest of it through. host:8080/path@x is the one shape this would misread —
# a port followed by a path — so a value that starts with a port is left alone.
URL_CRED = re.compile(r'(://[^/:@\s]+:)([^@\s]{3,}?)(@)')
URL_PORT = re.compile(r'\d{1,5}(?:/|$)')

# A label and the value after it. The label is what a secret is called; the
# value is only required to be long, because its shape says nothing.
#
# Huawei Cloud and OpenStack are the reason this tier exists in this form. Their
# access key is 20 characters of upper case and digits and the secret 40 of
# base62 — the same shapes as a git SHA, a build id, half the identifiers in
# ordinary output — so no pattern can take them without masking everything. The
# variable name can, and it is right there on the line. Jira reaches here too
# when a token is passed as --token rather than carrying its ATATT prefix.
LABEL = (r'(?:--?)?(?:pass|passwd|password|passphrase|pass-phrase'
         r'|token|secret|api[-_]?key|apikey|auth[-_]?token|access[-_]?key'
         r'|secret[-_]?key|client[-_]?secret|private[-_]?key|credential'
         # Authorization: Basic … carries user:password in base64, and a
         # kubeconfig's client-key-data is a whole private key in base64 —
         # neither has a prefix to recognise, only the name in front of it.
         r'|(?:proxy[-_])?authorization|client[-_]key[-_]data'
         r'|jira[-_]?(?:api[-_]?)?token'
         r'|hw[-_]?(?:access|secret)(?:[-_]?key)?'
         r'|huaweicloud?[-_]?[a-z_]*key'
         r'|os[-_](?:access|secret)[-_]?key'
         # …_AK and …_SK: Huawei's own SDKs spell the pair that way, and the
         # value carries no prefix at all, so the suffix is the whole signal.
         r'|(?:hw|huawei|huaweicloud|obs|os)[-_][a-z_0-9]*[-_]?[as]k)s?[A-Z0-9_]*')
VALUE = r'[A-Za-z0-9+/=_.~-]{16,}'

# Assignment first — NAME=value, NAME: value, Authorization: Bearer value —
# then the flag form, --pass value. Both keep the label readable: a summary that
# hides which credential was involved answers nothing.
# A quoted key closes its quote before the separator — "password":"…" in JSON,
# \"password\":\"…\" in JSON pasted into JSON — so the closing quote and its
# escape are allowed there; without them a logged request body passed untouched.
NAMED = re.compile(r'(%s)(\\?[\'"]?\s*[=:]\s*(?:(?:Bearer|Basic|Token|Digest)\s+)?)(\\?[\'"]?)(%s)' % (LABEL, VALUE), re.I)
FLAGGED = re.compile(r'(%s)(\s+)([\'"]?)(%s)' % (LABEL, VALUE), re.I)

# A password is short far more often than a key, and the 16-character floor let
# one through in plain sight: "password":"<10 characters>" in a request body
# pasted from an application log. So under a password-family label, and only in
# the assignment form, a value of 6 or more characters is masked when it holds a
# digit or a symbol: "password: required" stays readable, and "--pass through"
# is not an assignment at all.
PW_LABEL = r'\b(?:[A-Za-z0-9]+[-_])*(?:passwd|password|passphrase|pwd|pass)\b'
PW_VALUE = r'(?=[^\s\'"\\,;&]*[0-9!@#$%^*+=?])[^\s\'"\\,;&]{6,}'
NAMED_PW = re.compile(r'(%s)(\\?[\'"]?\s*[=:]\s*)(\\?[\'"]?)(%s)' % (PW_LABEL, PW_VALUE), re.I)

# A line that talks about credentials at all. Only there is a long anonymous
# run treated as a secret.
CRED_WORD = re.compile(
    r'token|secret|password|passwd|credential|api[ _-]?key|access[ _-]?key'
    r'|huawei|openstack|jira|токен|пароль|секрет|ключ', re.I)
# The third branch is base64: + and / split a key into runs shorter than 40, so
# without it an AWS secret key beside the word 'secret' passed in pieces. It
# needs a digit and both cases, which a path or a word never has all of.
HIGH_ENTROPY = re.compile(
    r'\b[A-Za-z0-9_-]{40,}\b|\b[A-Fa-f0-9]{32,}\b'
    r'|(?<![A-Za-z0-9+/])(?=[A-Za-z0-9+/]*[0-9])(?=[A-Za-z0-9+/]*[A-Z])'
    r'(?=[A-Za-z0-9+/]*[a-z])[A-Za-z0-9+/]{40,}={0,2}')

# The value one or two lines below its label: "the AWS secret is below" and
# then the key, alone on its line. Only a line that is nothing but one long
# run counts, so a SHA inside a sentence after a mention of a token stays.
LONE_TOKEN = re.compile(r'^(\s*[\'"]?)([A-Za-z0-9+/_=.~-]{20,})([\'"]?\s*)$')

# A private key is a block, not a token: the header line is all the PROVIDER
# tier sees, and the base64 body below it went through line by line. Everything
# from BEGIN to END is masked; a key with no END is masked to the end of the
# text. PEM_INLINE is the same key pasted into JSON, with \n escapes.
PEM_BEGIN = re.compile(r'-----BEGIN [A-Z0-9 ]*PRIVATE KEY(?: BLOCK)?-----')
PEM_END = re.compile(r'-----END [A-Z0-9 ]*PRIVATE KEY(?: BLOCK)?-----')
PEM_INLINE = re.compile(r'-----BEGIN [A-Z0-9 ]*PRIVATE KEY(?: BLOCK)?-----'
                        r'.*?-----END [A-Z0-9 ]*PRIVATE KEY(?: BLOCK)?-----')

# Environment as Kubernetes writes it: the name and the value are separate
# fields, so no label stands beside the value. In JSON both are on one line;
# in YAML the value is on the next one.
CRED_NAME = (r'[A-Za-z0-9_.-]*(?:pass(?:wd|word|phrase)?|pwd|token|secret'
             r'|api[-_]?key|apikey|access[-_]?key|private[-_]?key|credential'
             r'|authorization)[A-Za-z0-9_.-]*')
NAME_VALUE = re.compile(
    r'(\\?[\'"]?name\\?[\'"]?\s*[:=]\s*\\?[\'"]?%s\\?[\'"]?\s*,\s*'
    r'\\?[\'"]?value\\?[\'"]?\s*[:=]\s*\\?[\'"]?)([^\s\'"\\,}]{6,})' % CRED_NAME, re.I)
YAML_NAME = re.compile(r'^\s*-?\s*name:\s*[\'"]?%s[\'"]?\s*$' % CRED_NAME, re.I)
YAML_VALUE = re.compile(r'^(\s*value:\s*[\'"]?)([^\s\'"]{6,})')

# Two command lines that put a password right after a flag with no name a
# label could match: curl -u user:password and mysql -pPASSWORD. Each is
# masked only on a line that runs that program, so docker -u 1000:1000 and
# ssh -p 2222 stay as they are.
CURL_LINE = re.compile(r'\b(?:curl|wget|http)\b')
CURL_U = re.compile(r'((?:^|\s)(?:-u|--user)(?:\s+|=)?[\'"]?[^\s:\'"]+:)([^\s\'"]{3,})')
MYSQL_P = re.compile(r'(\b(?:mysql|mysqldump|mysqladmin|mariadb(?:-dump|-admin)?)\b'
                     r'[^\n]*?\s-p)([^\s\'"]{3,})')

# The patterns here are a fallback. The masking that is maintained — tested
# against a corpus, shared with the Claude Code, Codex and Opencode hooks — is
# secrets-redact from env2hell, and scrub() runs the finished text through it
# once when it is installed. Once, not per message: it is a process, and a
# long session has thousands of messages.
#
# IDE_SESSIONS_REDACTOR names another program, or turns it off when empty.
# A redactor that is installed but fails is not skipped quietly where the
# text is about to leave the machine: strict=True raises, and --sum stops
# rather than send what only the fallback has seen.
import os as _os, shutil as _shutil, subprocess as _subprocess

class RedactorFailed(Exception):
    pass

def scrub(text, strict=False):
    tool = _os.environ.get('IDE_SESSIONS_REDACTOR')
    if tool is None:
        tool = _shutil.which('secrets-redact') or ''
    if not tool or not text.strip():
        return text
    try:
        # --filter answers 0 when it masked something and 1 when the text
        # came through unchanged; anything else, or no text back, is a failure.
        p = _subprocess.run([tool, '--filter'], input=text, capture_output=True,
                            text=True, timeout=120)
        if p.returncode in (0, 1) and p.stdout.strip():
            return p.stdout
        why = 'exit %d%s' % (p.returncode, '' if p.stdout.strip() else ', no output')
    except (OSError, _subprocess.SubprocessError) as e:
        why = str(e)
    if strict:
        raise RedactorFailed('%s: %s' % (tool, why))
    return text

def mask(m):
    return '<REDACTED:%d>' % len(m.group(0))

def redact(text):
    out = []
    in_key = False          # inside a private key block
    yaml_name = 0           # lines left in which a YAML value: belongs to a credential name
    carry = 0               # lines left in which a lone token belongs to a label above it
    for line in (text or '').splitlines():
        if in_key:
            if PEM_END.search(line):
                in_key = False
                line = PEM_END.sub(mask, line)
            else:
                body = line.strip()
                line = line[:len(line) - len(line.lstrip())] + (
                    '<REDACTED:%d>' % len(body) if body else '')
            out.append(line)
            continue
        line = PEM_INLINE.sub(mask, line)
        if PEM_BEGIN.search(line) and not PEM_END.search(line):
            in_key = True
        line = PROVIDER.sub(mask, line)
        line = URL_CRED.sub(
            lambda m: m.group(0) if URL_PORT.match(m.group(2))
            else '%s<REDACTED:%d>%s' % (m.group(1), len(m.group(2)), m.group(3)), line)
        # A value already masked is left alone: masking the marker again would
        # overwrite the real length with the marker's own.
        for pat in (NAMED, FLAGGED, NAMED_PW):
            line = pat.sub(
                lambda m: m.group(0) if m.group(4).startswith('<REDACTED:')
                else '%s%s%s<REDACTED:%d>' % (m.group(1), m.group(2),
                                              m.group(3), len(m.group(4))),
                line)
        line = NAME_VALUE.sub(
            lambda m: '%s<REDACTED:%d>' % (m.group(1), len(m.group(2))), line)
        if yaml_name:
            line = YAML_VALUE.sub(
                lambda m: '%s<REDACTED:%d>' % (m.group(1), len(m.group(2))), line)
        yaml_name = 2 if YAML_NAME.search(line) else max(yaml_name - 1, 0)
        if CURL_LINE.search(line):
            line = CURL_U.sub(
                lambda m: '%s<REDACTED:%d>' % (m.group(1), len(m.group(2))), line)
        line = MYSQL_P.sub(
            lambda m: '%s<REDACTED:%d>' % (m.group(1), len(m.group(2))), line)
        if CRED_WORD.search(line):
            line = HIGH_ENTROPY.sub(mask, line)
            carry = 2
        else:
            if carry and LONE_TOKEN.match(line) and not line.strip().startswith('<REDACTED:'):
                line = LONE_TOKEN.sub(
                    lambda m: '%s<REDACTED:%d>%s' % (m.group(1), len(m.group(2)), m.group(3)), line)
            carry = max(carry - 1, 0)
        out.append(line)
    return '\n'.join(out)

# ── ABOUT column ────────────────────────────────────────────────────────────
#
# One line on where a long session ended, read from its own tool calls. No
# model is called, so it costs nothing and stays in the language the session
# was held in. Two signals, both shown: the subject of the last commit says
# what was finished, the last files edited say what the work was around. A
# commit subject alone can be too narrow to place a session, and neither
# needs a repository — a session that never committed shows its files. One
# that did neither shows its last request.
#
# Everything from here to the per-IDE part is the same in all three scripts;
# only about_events() knows this IDE's format.
import os, shlex

ABOUT_FILES = 3
ABOUT_MAX = 200
# `git` where a command starts: a line, or after && ; | ( — or behind rtk or an
# env assignment. A commit command quoted inside another one is not a commit.
GIT_COMMIT = re.compile(r'(?:^|[;&|(])\s*(?:rtk\s+)?(?:\w+=\S*\s+)*'
                        r'git(?:\s+-[Cc]\s+\S+)*\s+commit\b', re.M)
CAT_WRITE = re.compile(r'\bcat\s*>\s*([^\s<>|;&]+)\s*<<-?\s*[\'"]?(\w+)[\'"]?[^\n]*\n'
                       r'(.*?)\n\s*\2\b', re.S)

def first_line(text):
    for line in (text or '').splitlines():
        line = line.strip()
        if line:
            return line
    return ''

def tail_lines(path, size=2000000):
    # The end of a session is all this column reads; a long transcript is
    # megabytes, and the first line of a cut chunk is a broken record.
    with open(path, 'rb') as fh:
        fh.seek(0, 2)
        end = fh.tell()
        fh.seek(max(0, end - size))
        lines = fh.read().decode('utf-8', 'replace').split('\n')
    return lines[1:] if end > size else lines

def patch_events(text):
    # apply_patch: an added file carries its text on '+' lines, an updated one
    # only its name here.
    out, cur = [], None
    for line in (text or '').splitlines():
        if line.startswith('*** Add File: '):
            cur = ['write', line[14:].strip(), []]
            out.append(cur)
        elif line.startswith('*** Update File: '):
            cur = None
            out.append(['edit', line[17:].strip(), []])
        elif line.startswith('***'):
            cur = None
        elif cur is not None and line.startswith('+'):
            cur[2].append(line[1:])
    return [(k, p, '\n'.join(b)) for k, p, b in out]

def message_file(path, written, used):
    # `git commit -F FILE`: the message was usually written by the session
    # itself a moment earlier, so its own record has it even after the file
    # is gone. The disk is the fallback.
    for k, v in written.items():
        if k == path or k.endswith('/' + path):
            used.add(os.path.basename(k))
            return v
    if os.path.isabs(path) and os.path.isfile(path):
        used.add(os.path.basename(path))
        try:
            with open(path, errors='replace') as fh:
                return fh.read(4096)
        except OSError:
            pass
    return ''

def unquote(s):
    # shlex leaves the shell's \$ and \` inside double quotes as they were typed.
    return s.replace('\\$', '$').replace('\\`', '`')

def commit_subject(cmd, written, used):
    # None: not a commit. '': a commit whose message cannot be recovered.
    m = GIT_COMMIT.search(cmd or '')
    if not m:
        return None
    rest = cmd[m.end():]
    head, _, body = rest.partition('\n')
    if '<<' in head:
        return first_line(body)
    try:
        args = shlex.split(rest)
    except ValueError:
        args = rest.split()
    for i, a in enumerate(args):
        if a in ('&&', '||', ';', '|'):
            break
        nxt = args[i + 1] if i + 1 < len(args) else ''
        if a in ('-m', '--message'):
            return unquote(first_line(nxt))
        if a.startswith('--message='):
            return unquote(first_line(a[10:]))
        if a in ('-F', '--file'):
            return '' if nxt == '-' else first_line(message_file(nxt, written, used))
        if a.startswith('--file='):
            return first_line(message_file(a[7:], written, used))
        if a.startswith('-') and not a.startswith('--') and 'm' in a[1:]:
            return unquote(first_line(a[a.index('m', 1) + 1:] or nxt))
    return ''

def about_of(events):
    # events, oldest first: ('write', path, text) | ('edit', path, '')
    # | ('cmd', command, '') | ('ask', request, '')
    written, used, subject = {}, set(), None
    for kind, a, b in events:
        if kind == 'write':
            written[a] = b
        elif kind == 'cmd':
            for m in CAT_WRITE.finditer(a):
                written[m.group(1)] = m.group(3)
            s = commit_subject(a, written, used)
            if s is not None:
                subject = s
    # A scratch file in /tmp says less than a file of the work itself, so it
    # is shown only when the session edited nothing else.
    files, scratch, ask = [], [], ''
    for kind, a, b in reversed(events):
        if kind in ('write', 'edit'):
            name = os.path.basename(a.rstrip('/'))
            into = scratch if a.startswith(('/tmp/', '/var/tmp/')) else files
            if name and name not in into and name not in used and len(into) < ABOUT_FILES:
                into.append(name)
        elif kind == 'ask' and not ask:
            ask = first_line(a)
    files = files or scratch
    parts = []
    if subject:
        parts.append('commit: ' + subject)
    if files:
        parts.append('edit ' + ', '.join(files))
    if not parts and ask:
        parts.append('asked: ' + ask)
    line = ' '.join(redact('; '.join(parts)).split())
    return line if len(line) <= ABOUT_MAX else line[:ABOUT_MAX - 1] + '…'

def about_rows(rows_file, min_turns, turns_col):
    # Prints every listing row back with one more field. Below the threshold
    # it is empty; a session that cannot be read gets an empty one too — a
    # column is not worth a failed listing.
    with open(rows_file, errors='replace') as fh:
        rows = [r.rstrip('\n') for r in fh if r.strip()]
    abouts = []
    for row in rows:
        f = row.split('\t')
        try:
            long_enough = int(f[turns_col]) >= min_turns
        except (IndexError, ValueError):
            long_enough = False
        try:
            abouts.append(about_of(about_events(f)) if long_enough else '')
        except Exception:
            abouts.append('')
    # The shared redactor once over every line, as for a summary; the lines
    # are kept only if it gave back as many as it got.
    idx = [i for i, a in enumerate(abouts) if a]
    if idx:
        masked = scrub('\n'.join(abouts[i] for i in idx)).rstrip('\n').split('\n')
        if len(masked) == len(idx):
            for i, a in zip(idx, masked):
                abouts[i] = a
    for row, about in zip(rows, abouts):
        print(row + '\t' + about)

# ── ABOUT: this IDE ─────────────────────────────────────────────────────────
def about_events(f):
    events = []
    for line in tail_lines(f[4]):
        if '"tool_use"' not in line and '"user"' not in line:
            continue
        try:
            d = json.loads(line)
        except ValueError:
            continue
        if d.get('isSidechain') or d.get('isMeta') or d.get('isCompactSummary'):
            continue
        content = (d.get('message') or {}).get('content')
        if d.get('type') == 'user':
            if isinstance(content, list):
                content = '\n'.join(b.get('text', '') for b in content
                                    if isinstance(b, dict) and b.get('type') == 'text')
            txt = clean(content if isinstance(content, str) else '')
            # A task notification or an interrupt marker is the harness, not a request.
            if txt and not txt.startswith(('[Request interrupted', '<task-notification>')):
                events.append(('ask', txt, ''))
        elif d.get('type') == 'assistant' and isinstance(content, list):
            for b in content:
                if not isinstance(b, dict) or b.get('type') != 'tool_use':
                    continue
                inp = b.get('input') or {}
                name = b.get('name')
                if name == 'Write':
                    events.append(('write', inp.get('file_path') or '',
                                   inp.get('content') or ''))
                elif name in ('Edit', 'MultiEdit', 'NotebookEdit'):
                    events.append(('edit', inp.get('file_path')
                                   or inp.get('notebook_path') or '', ''))
                elif name == 'Bash':
                    events.append(('cmd', inp.get('command') or '', ''))
    return events

# ── SEARCH ──────────────────────────────────────────────────────────────────
#
# `--search PATTERN`: the sessions that mention something, and how much. A hit
# is counted where it was said — the user's prompts, the model's replies, or
# its tool calls and their output — because only the first says the work was
# about it: one file read can put a word in a session forty times. Context the
# harness injects (instructions, reminders, skill bodies) is not counted at all.
#
# PATTERN is Python's re, any case, ^ and $ at every line. Reading every
# transcript with it takes seconds; ripgrep first picks the lines that can
# match, and only those are decoded and counted. ripgrep reads the raw JSON,
# where a newline is `\n` and a quote `\"`, so it gets a wider pattern: no
# anchors or lookarounds, and an escape sequence allowed wherever a character
# could stand. Wider only — a line it skips cannot match.
#
# Everything from here to the per-IDE part is the same in all three scripts;
# only search_count() and what it calls know this IDE's format.
import shutil, subprocess

SEARCH_ESC = r'\\+(?:[nrtbf"\\/]|u[0-9a-fA-F]{4})'
SEARCH_ANY = '(?s:.*?)'

def search_rx(pattern):
    try:
        rx = re.compile(pattern, re.I | re.M)
    except re.error as e:
        raise SystemExit('--search: not a regular expression: %s' % e)
    if rx.search(''):
        raise SystemExit('--search: %r matches empty text, so it matches everywhere' % pattern)
    return rx

def search_group_end(p, i):
    # Index just past the group that opens at p[i] == '('.
    depth, n = 0, len(p)
    while i < n:
        c = p[i]
        if c == '\\':
            i += 2
            continue
        if c == '[':
            i = search_class_end(p, i)
            continue
        if c == '(':
            depth += 1
        elif c == ')':
            depth -= 1
            if depth == 0:
                return i + 1
        i += 1
    return n

def search_class_end(p, i):
    # Index just past the class that opens at p[i] == '['.
    n, j = len(p), i + 1
    if j < n and p[j] == '^':
        j += 1
    if j < n and p[j] == ']':
        j += 1
    while j < n and p[j] != ']':
        j += 2 if p[j] == '\\' else 1
    return min(j + 1, n)

def search_char(c):
    # A non-ASCII character may sit in the JSON as \uXXXX, in either case.
    if ord(c) < 128:
        return re.escape(c)
    alts = {re.escape(c)}
    for v in (c.lower(), c.upper()):
        if len(v) == 1 and ord(v) < 0x10000:
            alts.add(re.escape(v))
            alts.add(r'\\+u%04x' % ord(v))
    return '(?:%s)' % '|'.join(sorted(alts))

def search_wide(p):
    out, i, n = [], 0, len(p)
    while i < n:
        c = p[i]
        if c == '\\' and i + 1 < n:
            e = p[i + 1]
            i += 2
            if e in 'bBAZzG':
                continue
            if e in '123456789':
                while i < n and p[i].isdigit():
                    i += 1
                out.append(SEARCH_ANY)
            elif e in 'xuUN':
                k = {'x': 2, 'u': 4, 'U': 8}.get(e, 0)
                if e == 'N' and i < n and p[i] == '{':
                    k = p.find('}', i) + 1 - i if '}' in p[i:] else n - i
                i += k
                out.append('(?:(?s:.)|%s)' % SEARCH_ESC)
            elif e == '0':
                out.append('(?:\\x00|%s)' % SEARCH_ESC)
            elif e in 'sSWDnrtfv':
                out.append('(?:\\%s|%s)' % (e, SEARCH_ESC))
            elif e == '\\':
                out.append(r'\\+')
            elif e == '"':
                out.append(r'\\*"')
            else:
                out.append(search_char(e) if ord(e) >= 128 else '\\' + e)
        elif c == '[':
            j = search_class_end(p, i)
            out.append('(?:%s|%s)' % (p[i:j], SEARCH_ESC))
            i = j
        elif c == '(':
            j = search_group_end(p, i)
            head = p[i:i + 4]
            if head.startswith(('(?=', '(?!', '(?<=', '(?<!', '(?#')):
                i = j
            elif head.startswith(('(?P=', '(?(')):
                out.append(SEARCH_ANY)
                i = j
            else:
                out.append(c)
                i += 1
        elif c in '^$':
            i += 1
        elif c == '.':
            out.append('(?:.|%s)' % SEARCH_ESC)
            i += 1
        elif c == '"':
            out.append(r'\\*"')
            i += 1
        elif ord(c) >= 128:
            out.append(search_char(c))
            i += 1
        else:
            out.append(c)
            i += 1
    return ''.join(out)

def search_lines(wide, paths):
    # {path: {line numbers}} of the lines ripgrep says can match.
    rg = shutil.which('rg')
    if not rg:
        raise SystemExit(
            '--search needs ripgrep (rg), and it is not installed.\n'
            'Install it:  apt install ripgrep  |  dnf install ripgrep  |  brew install ripgrep')
    found = {}
    for k in range(0, len(paths), 500):
        r = subprocess.run([rg, '--no-config', '--engine', 'auto', '-i', '-n', '-H',
                            '--null', '--no-heading', '--max-columns', '1',
                            '-e', wide, '--'] + paths[k:k + 500],
                           stdout=subprocess.PIPE, stderr=subprocess.PIPE)
        if r.returncode not in (0, 1):
            raise SystemExit('--search: ripgrep refused the pattern:\n%s'
                             % r.stderr.decode('utf-8', 'replace').strip())
        for line in r.stdout.decode('utf-8', 'replace').splitlines():
            path, _, rest = line.partition('\0')
            num = rest.split(':', 1)[0]
            if num.isdigit():
                found.setdefault(path, set()).add(int(num))
    return found

def flat(v):
    # Every string inside a tool's input or output, keys and type tags aside;
    # an image is base64 and only ever matches by accident.
    if isinstance(v, str):
        return v
    if isinstance(v, list):
        return '\n'.join(flat(x) for x in v)
    if isinstance(v, dict):
        if v.get('type') in ('image', 'input_image'):
            return ''
        return '\n'.join(flat(x) for k, x in v.items() if k != 'type')
    return ''

def search_jsonl(rows, rx, pattern, extra):
    # Hits per row, for an IDE that keeps a session in JSONL files: ripgrep
    # picks the lines, search_parts() says whose words each one holds.
    files = [search_files(r.split('\t'), extra) for r in rows]
    lines = search_lines(search_wide(pattern), sorted({p for fs in files for p, _ in fs}))
    out = []
    for fs in files:
        hits = [0, 0, 0]
        for path, sub in fs:
            want = lines.get(path)
            if not want:
                continue
            # A rollout written across a format change holds every message
            # twice; the older copy counts only where the newer has none.
            new, old, last = [0, 0, 0], [0, 0, 0], max(want)
            with open(path, errors='replace') as fh:
                for num, raw in enumerate(fh, 1):
                    if num > last:
                        break
                    if num not in want:
                        continue
                    try:
                        d = json.loads(raw)
                    except ValueError:
                        continue
                    if not isinstance(d, dict):
                        continue
                    for who, text, legacy in search_parts(d):
                        k = sum(1 for _ in rx.finditer(text or ''))
                        (old if legacy else new)[2 if sub else who] += k
            use = old if not (new[0] or new[1]) else [0, 0, 0]
            for i in range(3):
                hits[i] += new[i] + use[i]
        out.append(hits)
    return out

def search_rows(rows_file, pattern, min_hits, extra):
    # Prints the rows with a hit, each with its counts as one more field. The
    # rows arrive newest first and the sort is stable, so ties stay that way.
    rx = search_rx(pattern)
    with open(rows_file, errors='replace') as fh:
        rows = [r.rstrip('\n') for r in fh if r.strip()]
    out = [(h, r) for h, r in zip(search_count(rows, rx, pattern, extra), rows)
           if sum(h) and sum(h) >= min_hits]
    out.sort(key=lambda x: (-x[0][0], -sum(x[0])))
    for hits, row in out:
        print('%s\t%d/%d/%d' % (row, hits[0], hits[1], hits[2]))

# ── SEARCH: this IDE ────────────────────────────────────────────────────────
def search_count(rows, rx, pattern, extra):
    return search_jsonl(rows, rx, pattern, extra)

import glob

# Typed into the prompt but written by the machine: the output of a command the
# user ran, a subagent's report. Counted as tool work, not as the user's words.
SEARCH_MACHINE = ('<local-command-stdout>', '<local-command-stderr>',
                  '<bash-stdout>', '<bash-stderr>', '<task-notification>')
# Injected, never typed: counted nowhere.
SEARCH_INJECTED = ('Caveat: The messages below were generated',
                   'Base directory for this skill:', '[Request interrupted')

def search_files(f, extra):
    # The transcript, then its subagents' logs — their work is tool work.
    subs = glob.glob(os.path.join(os.path.dirname(f[4]), f[1], 'subagents', '*.jsonl'))
    return [(f[4], False)] + [(p, True) for p in sorted(subs)]

def search_parts(d):
    # (who, text, legacy): who is 0 the user, 1 the model, 2 its tools.
    kind = d.get('type')
    if kind not in ('user', 'assistant') or d.get('isMeta') or d.get('isCompactSummary'):
        return []
    content = (d.get('message') or {}).get('content')
    if isinstance(content, str):
        content = [{'type': 'text', 'text': content}]
    out = []
    for b in content if isinstance(content, list) else []:
        if not isinstance(b, dict):
            continue
        t = b.get('type')
        if t == 'text':
            txt = REMINDER.sub('', b.get('text') or '')
            head = txt.lstrip()
            if kind == 'assistant':
                out.append((1, txt))
            elif head.startswith(SEARCH_MACHINE):
                out.append((2, txt))
            elif not head.startswith(SEARCH_INJECTED):
                out.append((0, txt))
        elif t == 'thinking':
            out.append((1, b.get('thinking') or ''))
        elif t == 'tool_use':
            out.append((2, flat(b.get('input'))))
        elif t == 'tool_result':
            out.append((2, REMINDER.sub('', flat(b.get('content')))))
    if d.get('isSidechain'):
        out = [(2, x) for _, x in out]
    return [(w, x, False) for w, x in out]

# `--about ROWS MIN`: the listing's ABOUT column, then nothing else.
if path == '--about':
    about_rows(sys.argv[3], int(sys.argv[4]), 3)
    sys.exit(0)

# `--search ROWS PATTERN MIN [EXTRA]`: the rows that mention PATTERN, each with
# its hits, most mentioned by the user first; then nothing else.
if path == '--search':
    search_rows(sys.argv[3], sys.argv[4], int(sys.argv[5]),
                sys.argv[6] if len(sys.argv) > 6 else '')
    sys.exit(0)

turns = []
with open(path, errors='replace') as fh:
    for line in fh:
        try:
            d = json.loads(line)
        except ValueError:
            continue
        if d.get('type') not in ('user', 'assistant') or d.get('isSidechain'):
            continue
        try:
            ep = datetime.datetime.fromisoformat(
                (d.get('timestamp') or '').replace('Z', '+00:00')).timestamp()
        except ValueError:
            ep = 0.0
        content = (d.get('message') or {}).get('content')
        text, tools = [], []
        if isinstance(content, str):
            text.append(content)
        elif isinstance(content, list):
            for b in content:
                if not isinstance(b, dict):
                    continue
                if b.get('type') == 'text':
                    text.append(b.get('text', ''))
                elif b.get('type') == 'tool_use':
                    tools.append(b.get('name', '?'))
        txt = redact(clean('\n'.join(x for x in text if x)))
        if not txt and not tools:
            continue
        turns.append({'ep': ep, 'role': d['type'], 'txt': txt,
                      'tools': tools, 'cwd': d.get('cwd') or ''})

if not turns:
    sys.exit(3)

# ── segment ─────────────────────────────────────────────────────────────────
segments, cur, last_ep, last_cwd = [], [], None, None
for t in turns:
    boundary = (last_ep is not None and t['ep'] and t['ep'] - last_ep > gap) or \
               (t['cwd'] and last_cwd and t['cwd'] != last_cwd)
    if boundary and cur:
        segments.append(cur)
        cur = []
    cur.append(t)
    last_ep = t['ep'] or last_ep
    last_cwd = t['cwd'] or last_cwd
if cur:
    segments.append(cur)

def when(ep):
    return datetime.datetime.fromtimestamp(ep).strftime('%Y-%m-%d %H:%M') if ep else '?'

def cut(s, n):
    s = ' '.join(s.split())
    return s if len(s) <= n else s[:n - 1] + '…'

# The model sees each exchange as a pair: what was asked, and what the turn
# ended with -- the last thing the assistant said before the next ask. That is
# where the outcome is; the first reply of a turn is usually "let me check".
#
# Pairs are taken at an even step across each part, not from its two ends. A
# part of 40 asks used to keep its first and last four, and whatever the work
# was in the middle never reached the model: a week of alerting work on one
# cluster came back as three bullets under other headings. The budget is a
# number of pairs for the whole digest, shared by parts in proportion to their
# length, so a short session goes in whole and a long one at an even step.
DIGEST_PAIRS = 100

def pairs(seg):
    out, cur = [], None
    for t in seg:
        if not t['txt']:
            continue
        if t['role'] == 'user':
            cur = {'ask': t['txt'], 'done': ''}
            out.append(cur)
        else:
            if cur is None:
                cur = {'ask': '', 'done': ''}
                out.append(cur)
            cur['done'] = t['txt']
    return out

def spread(items, keep):
    if len(items) <= keep:
        return items
    if keep <= 1:
        return items[-1:]
    step = (len(items) - 1) / (keep - 1)
    return [items[round(i * step)] for i in range(keep)]

seg_pairs = [pairs(seg) for seg in segments]
total = sum(len(p) for p in seg_pairs)
quota = [len(p) if total <= DIGEST_PAIRS else max(2, round(DIGEST_PAIRS * len(p) / total))
         for p in seg_pairs]

out = []
for i, seg in enumerate(segments, 1):
    users = [t for t in seg if t['role'] == 'user' and t['txt']]
    bots = [t for t in seg if t['role'] == 'assistant' and t['txt']]
    tools = {}
    for t in seg:
        for name in t['tools']:
            tools[name] = tools.get(name, 0) + 1
    cwd = next((t['cwd'] for t in seg if t['cwd']), '?')
    out.append('## part %d — %s — %s → %s — %d turns'
               % (i, cwd, when(seg[0]['ep']), when(seg[-1]['ep']), len(seg)))
    for p in spread(seg_pairs[i - 1], quota[i - 1]):
        if p['ask']:
            out.append('ASKED: ' + cut(p['ask'], 300))
        if p['done']:
            out.append('DONE: ' + cut(p['done'], 400))
    if tools:
        top = sorted(tools.items(), key=lambda kv: -kv[1])[:8]
        out.append('TOOLS: ' + ', '.join('%s x%d' % (k, v) for k, v in top))
    out.append('')

# The digest is what leaves the machine, so it is what the shared redactor
# sees — once, whole. Exit 5: it is installed and failed, nothing is sent.
try:
    print(scrub('\n'.join(out), strict=True))
except RedactorFailed as e:
    sys.stderr.write('Not sent: the secrets redactor failed (%s).\n'
                     'Fix it, or set IDE_SESSIONS_REDACTOR= to mask with the built-in '
                     'patterns only.\n' % e)
    sys.exit(5)
PY
}

# The language rule is the whole difference between --sum and --sum-orig, so it
# is one variable inside one prompt. Two separate prompts would drift apart at
# the first edit to everything they have in common.
if [ "$SUM_LANG" = orig ]; then
  SUM_LANG_RULE='- Write in the language the session itself was held in. Where more than one was
  used, take the language the user typed most, and use only that one — do not
  mix two languages in a summary and do not translate into English.'
else
  SUM_LANG_RULE='- Write in English only. One session can mix languages — Russian, German, any
  other, sometimes inside a single sentence. Translate all of it; never leave a
  phrase in the original language and never answer in it.'
fi

# What the model is asked for. Kept next to the digest so the two are read
# together: the digest decides what the model can see, this decides what it
# does with it.
SUM_PROMPT="Below is a machine-made digest of one AI coding session: the user's asks, each paired with what that turn ended with (DONE), and tool counts, already split into parts.

Write a summary of what was DONE in that session.

Rules:
$SUM_LANG_RULE
- Keep verbatim, untranslated: code, file paths, commands, flags, identifiers,
  branch names, error strings.
- Never write out a key, token, password or other credential, even if one
  appears in the digest. Anything already masked as <REDACTED:N> stays masked;
  say what it was for, not what it was.
- One '### ' heading per distinct topic, 4-8 words, naming the actual subject.
- Under each heading, 2-4 bullets. A bullet is <= 14 words, past tense, and names
  something concrete: a file, a command, a tool, a decision, a number.
- Merge parts that are the same topic. At most 5 headings for a session held on
  one day, at most 8 when the parts span several days.
- Say what was decided or found, not what was discussed.
- No preamble, no closing remarks, no restating these rules."

# Model choice, in order: what the user asked for, then the cheapest priced
# model of this IDE's provider found in a models.dev catalogue already on disk,
# then the CLI's own alias for its small model. No model name or version is
# pinned in this file — a new cheap model is picked up as soon as the catalogue
# on disk knows about it.
sum_pick_model() {
  [ -n "$SUM_MODEL" ] && { printf '%s' "$SUM_MODEL"; return; }
  local cat picked
  for cat in "${IDE_SESSIONS_MODELS_JSON:-}" \
             "$HOME/.cache/ide-sessions/models.dev.json" \
             "$HOME/.cache/opencode/models.json"; do
    [ -n "$cat" ] && [ -f "$cat" ] || continue
    picked=$(python3 - "$cat" anthropic <<'PY' 2>/dev/null || true
import json, sys
try:
    db = json.load(open(sys.argv[1]))
    models = db[sys.argv[2]]['models']
except Exception:
    sys.exit(1)
best = None
for mid, m in models.items():
    cost = (m.get('cost') or {}).get('input')
    ctx = (m.get('limit') or {}).get('context') or 0
    # A zero price means "not priced here" (promo, subscription) far more often
    # than "free", and picking one on that basis is how a summary silently
    # lands on a model nobody meant to use.
    if not cost or cost <= 0 or ctx < 100000:
        continue
    if best is None or cost < best[0]:
        best = (cost, mid)
print(best[1] if best else '')
PY
)
    [ -n "$picked" ] && { printf '%s' "$picked"; return; }
  done
  printf 'haiku'
}

# A summary of a long session is one model call and takes as long as it takes —
# 79 seconds for a ten-part digest, measured. A terminal with nothing on it for
# that long reads as a hang, so say what is happening and count the seconds.
#
# Only when stderr is a terminal: in a pipe or a script the carriage returns
# would end up in a file, and the summary on stdout has to stay clean either
# way.
SUM_PROGRESS_PID=""
sum_progress_start() {
  [ -t 2 ] || return 0
  local msg="$1"
  (
    i=0
    while :; do
      printf '\r  %s… %ds' "$msg" "$i" >&2
      i=$((i + 1))
      sleep 1
    done
  ) &
  SUM_PROGRESS_PID=$!
}

sum_progress_stop() {
  [ -n "$SUM_PROGRESS_PID" ] || return 0
  kill "$SUM_PROGRESS_PID" 2>/dev/null || true
  wait "$SUM_PROGRESS_PID" 2>/dev/null || true
  SUM_PROGRESS_PID=""
  # \033[K clears what the counter left on the line; without it the next
  # output lands on top of half a progress line.
  printf '\r\033[K' >&2
}

# An interrupted run must not leave the counter running in the background.
trap 'sum_progress_stop' EXIT
# Ctrl-C and kill end the script. A handler that only cleans up returns, and
# bash carries on from the next line: an interrupted model call then left its
# last words ("Execution error" from claude -p) as the summary, cached for good.
# exit runs the EXIT trap, so the cleanup still happens.
trap 'exit 130' INT
trap 'exit 143' TERM


# ── --list-models ───────────────────────────────────────────────────────────
# Claude Code has no command that lists models, so the list is built from the
# two sources that are certain to be accepted by `claude -p --model`: the
# aliases Claude Code documents (code.claude.com/docs/en/model-config), and the
# full names this account has actually run, read from its own transcripts.
list_models() {
  echo "Models --sum-model accepts — passed to \`claude -p --model\`"
  echo
  echo "Aliases — Claude Code maps each to the current model of that family"
  printf '  %-12s %s\n' \
    haiku      "fast and efficient, for simple tasks" \
    sonnet     "the latest Sonnet, for daily coding" \
    opus       "the latest Opus, for complex reasoning" \
    fable      "Fable, for the hardest and longest-running tasks" \
    best       "fable where it is available to you, otherwise opus" \
    'opus[1m]'   "opus with a 1M-token context window" \
    'sonnet[1m]' "sonnet with a 1M-token context window"
  echo
  echo "Full names this account has run — from its transcripts, newest first"
  python3 - "$CONFIG_DIR/projects" <<'PY'
import os, re, sys, glob, datetime
root = sys.argv[1]
files = glob.glob(os.path.join(root, '*', '*.jsonl'))
files.sort(key=lambda f: os.path.getmtime(f), reverse=True)
seen = {}
pat = re.compile(rb'"model":"(claude-[A-Za-z0-9.\-]+)"')
for f in files:
    try:
        with open(f, 'rb') as fh:
            names = set(pat.findall(fh.read()))
    except OSError:
        continue
    for n in names:
        n = n.decode()
        if n not in seen:
            seen[n] = os.path.getmtime(f)
if not seen:
    print('  (none found under %s)' % root)
for n, t in sorted(seen.items(), key=lambda kv: kv[1], reverse=True):
    day = datetime.datetime.fromtimestamp(t).strftime('%Y-%m-%d')
    print('  %-34s last used %s' % (n, day))
PY
  echo
  if [ -n "$SUM_MODEL" ]; then
    echo "Model for --sum now: $SUM_MODEL   (set by --sum-model or IDE_SESSIONS_SUM_MODEL)"
  else
    echo "Model for --sum by default: $(sum_pick_model)"
    echo "  (the cheapest priced Anthropic model in a models.dev catalogue on disk,"
    echo "   or the alias haiku when there is none)"
  fi
  echo "To pick another:  claude-sessions --sum <ID> --sum-model <a name above>"
  echo "  e.g.            claude-sessions --sum <ID> --sum-model sonnet"
}

if [ "$LIST_MODELS" = 1 ]; then
  list_models
  exit 0
fi
if [ -n "$SUM_ID" ]; then
  transcript=$(find "$PROJECTS_DIR" -maxdepth 2 -name "$SUM_ID.jsonl" -print -quit 2>/dev/null || true)
  if [ -z "$transcript" ]; then
    echo "No transcript for session $SUM_ID under $PROJECTS_DIR" >&2
    echo "List the ids with: claude-sessions" >&2
    exit 1
  fi

  if [ "$SUM_RAW" = 1 ]; then
    sum_digest "$transcript" || {
      [ $? = 5 ] && exit 1
      echo "Nothing to summarize: $SUM_ID has no user or assistant turns." >&2
      exit 1
    }
    exit 0
  fi

  model=$(sum_pick_model)
  src_mtime=$(stat -c %Y "$transcript" 2>/dev/null || echo 0)
  key="ide-sessions-sum v2 src=$src_mtime model=$model gap=$SUM_GAP lang=$SUM_LANG"
  cache_file="$SUM_CACHE/claude-$SUM_ID$SUM_FILE_SUFFIX.md"

  # The cache is keyed by the transcript's mtime, so a session that has since
  # been resumed re-summarizes itself and one that has not costs nothing twice.
  # Checked before the digest is built, not after: parsing a 9 MB transcript
  # takes about 0.6 s, and doing it to then throw the result away was most of
  # what a cache hit cost.
  if [ "$SUM_REFRESH" != 1 ] && [ -f "$cache_file" ] &&
     [ "$(head -1 "$cache_file")" = "<!-- $key -->" ]; then
    tail -n +2 "$cache_file"
    exit 0
  fi

  digest=$(sum_digest "$transcript") || {
    [ $? = 5 ] && exit 1
    echo "Nothing to summarize: $SUM_ID has no user or assistant turns." >&2
    exit 1
  }

  command -v claude >/dev/null 2>&1 || {
    echo "claude CLI not found — needed to write the summary." >&2
    echo "Use --sum-raw for the extracted digest without a model." >&2
    exit 1
  }

  # --setting-sources '' and an empty MCP config are not tidiness: with the
  # user's CLAUDE.md, skills and MCP servers loaded, the same one-line prompt
  # measured 40 179 input tokens against 4 591 without them.
  # Summarizing writes a session of its own — `claude -p` is a session like any
  # other. Left alone, every --sum added a row to the very listing this script
  # exists to keep readable, and two summaries in a row looked like the tool
  # breeding sessions.
  #
  # The id is chosen here rather than read back afterwards, so the cleanup knows
  # what to remove even when the call fails or is interrupted.
  scratch_id=$(python3 -c 'import uuid; print(uuid.uuid4())')

  sum_scratch_remove() {
    local sid="$1" path
    [ -n "$sid" ] || return 0
    path=$(find "$PROJECTS_DIR" -maxdepth 2 -name "$sid.jsonl" -print -quit 2>/dev/null || true)
    [ -n "$path" ] || return 0
    footprint_of "$sid" "$path" | while IFS= read -r p; do
      if [ -e "$p" ]; then rm -rf "$p"; fi
    done
  }

  # An interrupted summary must not leave its scratch session behind either.
  trap 'sum_progress_stop; sum_scratch_remove "$scratch_id"' EXIT

  sum_progress_start "summarizing $(printf '%s\n' "$digest" | grep -c '^## part') part(s) with $model"

  summary=$(printf '%s\n\n%s\n' "$SUM_PROMPT" "$digest" |
    claude -p \
      --model "$model" \
      --session-id "$scratch_id" \
      --setting-sources '' \
      --strict-mcp-config --mcp-config '{"mcpServers":{}}' \
      --disable-slash-commands \
      --disallowedTools "Bash Edit Write Read Glob Grep WebFetch WebSearch Agent Task" \
      2>/dev/null) || summary=""
  sum_progress_stop
  sum_scratch_remove "$scratch_id"

  # A model name from a catalogue can be one this account cannot call. Rather
  # than fail, fall back to whatever model the CLI would have chosen itself.
  if [ -z "$summary" ] && [ -z "$SUM_MODEL" ]; then
    scratch_id=$(python3 -c 'import uuid; print(uuid.uuid4())')
    sum_progress_start "retrying with the model the CLI picks itself"
    summary=$(printf '%s\n\n%s\n' "$SUM_PROMPT" "$digest" |
      claude -p \
        --session-id "$scratch_id" \
        --setting-sources '' \
        --strict-mcp-config --mcp-config '{"mcpServers":{}}' \
        --disable-slash-commands \
        --disallowedTools "Bash Edit Write Read Glob Grep WebFetch WebSearch Agent Task" \
        2>/dev/null) || summary=""
    sum_progress_stop
    sum_scratch_remove "$scratch_id"
    model="(CLI default)"
  fi

  if [ -z "$summary" ]; then
    echo "The model returned nothing. Re-run with --sum-raw to see the digest." >&2
    exit 1
  fi

  # A summary can still name what a secret was for, and it is written without
  # being read again. Keep it to this user: 0700 on the directory, 0600 on the
  # file, set before the content goes in.
  mkdir -p "$SUM_CACHE"
  chmod 700 "$SUM_CACHE" 2>/dev/null || true
  : > "$cache_file"
  chmod 600 "$cache_file" 2>/dev/null || true
  { printf '<!-- %s -->\n' "$key"; printf '%s\n' "$summary"; } > "$cache_file"
  # Which model wrote this goes to stderr, so `--sum | …` stays pure summary.
  echo "summarized with $model" >&2
  printf '%s\n' "$summary"
  exit 0
fi

DELETE_MODE=0
[ -n "$RM_IDS$OLDER_THAN$MAX_TURNS" ] && DELETE_MODE=1
[ "$RM_ALL" = 1 ] && DELETE_MODE=1

# An explicit id list is intent enough to delete after a prompt. Bulk criteria
# can sweep up far more than intended, so they stay dry-run until --apply.
BULK=0
[ -n "$OLDER_THAN$MAX_TURNS" ] && BULK=1
# --rm-all is the widest selection there is, so it dry-runs like the rest.
[ "$RM_ALL" = 1 ] && BULK=1

# --rm-all with nothing to narrow it selects every session on the machine. That
# is the one command a person runs before reading the rest of the help, so it
# refuses: a scope has to be named, or the global sweep asked for by name.
if [ "$RM_ALL" = 1 ] && [ "$PROJECT_SCOPE" != 1 ] && [ -z "$FILTER" ] && [ "$EVERYWHERE" != 1 ]; then
  {
    echo "--rm-all needs something to narrow it — on its own it means every session"
    echo "of every project on this machine."
    echo
    echo "  claude-sessions -p --rm-all --apply          this project only"
    echo "  claude-sessions <substring> --rm-all --apply  directories matching <substring>"
    echo "  claude-sessions --rm-all --everywhere        every project, listed first"
  } >&2
  exit 1
fi

for n in "$OLDER_THAN" "$MAX_TURNS"; do
  case "$n" in
    '') ;;
    *[!0-9]*) echo "--older-than/--max-turns want a plain number, got: $n" >&2; exit 1 ;;
  esac
done
case "$MIN_HITS" in
  ''|*[!0-9]*) echo "--min-hits wants a plain number, got: $MIN_HITS" >&2; exit 1 ;;
esac
# A search answers "where did I work on X"; deleting by what a session merely
# mentions would sweep far more than that, so the two do not combine.
if [ -n "$SEARCH" ] && [ "$DELETE_MODE" = 1 ]; then
  echo "--search only lists. Delete what it finds by id: claude-sessions --rm <ID>" >&2
  exit 1
fi
case "$ABOUT_MIN" in
  ''|*[!0-9]*) echo "--about-min wants a plain number, got: $ABOUT_MIN" >&2; exit 1 ;;
esac

CURRENT_ID="${CLAUDE_CODE_SESSION_ID:-}"

SCAN_DIR="$PROJECTS_DIR"
SCAN_DEPTH=2
if [ "$PROJECT_SCOPE" = 1 ]; then
  SCAN_DIR="$PROJECTS_DIR/$(pwd | sed -E 's/[^a-zA-Z0-9]/-/g')"
  SCAN_DEPTH=1
fi

# A directory that never hosted a session has no project dir at all, and `find`
# over a missing path fails — which, under `set -euo pipefail`, killed the
# script before it printed anything: no output, exit 1. Skipping the scan
# instead leaves the row list empty, and the one message every empty result
# shares says the rest. One state, one sentence, the same in all three tools.

# Collect: mtime_epoch \t session_id \t cwd \t turns \t transcript_path
tmpfile=$(mktemp)
trap 'rm -f "$tmpfile"' EXIT

if [ -d "$SCAN_DIR" ]; then
find "$SCAN_DIR" -maxdepth "$SCAN_DEPTH" -name "*.jsonl" -print0 2>/dev/null | while IFS= read -r -d '' f; do
  mtime=$(stat -c %Y "$f" 2>/dev/null || echo 0)
  [ "$mtime" = 0 ] && continue
  sid=$(basename "$f" .jsonl)
  cwd=$( (grep -m1 -o '"cwd":"[^"]*"' "$f" || true) 2>/dev/null | head -1 | sed -E 's/"cwd":"(.*)"/\1/')
  [ -z "$cwd" ] && cwd="(unknown)"
  turns=$(wc -l < "$f" 2>/dev/null | tr -d ' ')
  printf '%s\t%s\t%s\t%s\t%s\n' "$mtime" "$sid" "$cwd" "$turns" "$f" >> "$tmpfile"
done
fi

now=$(date +%s)

format_age() {
  local d=$(( now - $1 ))
  if [ "$d" -lt 60 ]; then echo "${d}s ago"
  elif [ "$d" -lt 3600 ]; then echo "$(( d/60 ))m ago"
  elif [ "$d" -lt 86400 ]; then echo "$(( d/3600 ))h ago"
  else echo "$(( d/86400 ))d ago"
  fi
}

shorten_dir() {
  local p="$1"
  [ "$FULL_PATH" = 1 ] && { echo "$p"; return; }
  echo "$p" | awk -F/ '{ n=NF; if (n<=3) print $0; else print $(n-2)"/"$(n-1)"/"$n }'
}

# The widest DIR as shown, and whether any row carries an ABOUT. Read from the
# rows in one pass, so DIR can be padded before the first line is printed.
about_widths() {
  awk -F'\t' -v d="$1" -v a="$2" -v full="$FULL_PATH" '
    { p = $d
      if (full != 1) { n = split(p, s, "/"); if (n > 3) p = s[n-2] "/" s[n-1] "/" s[n] }
      if (length(p) > w) w = length(p)
      if ($a != "") any = 1 }
    END { print w + 0, any + 0 }'
}

# A long ABOUT wraps at word boundaries, so nothing of it is hidden: the first
# line takes ROOM characters, each further line starts with PAD and takes REST.
about_lines() {
  local text="$1" width="$2" rest="$3" pad="$4" line="" word sep=""
  local -a words
  if [ "$width" -le 0 ] || [ "${#text}" -le "$width" ]; then
    printf '%s' "$text"
    return
  fi
  read -r -a words <<< "$text"
  for word in "${words[@]}"; do
    if [ -z "$line" ]; then
      line=$word
    elif [ $(( ${#line} + 1 + ${#word} )) -le "$width" ]; then
      line="$line $word"
    else
      printf '%s%s' "$sep" "$line"; sep=$'\n'$pad; width=$rest
      line=$word
    fi
    while [ "${#line}" -gt "$width" ]; do
      printf '%s%s' "$sep" "${line:0:$width}"; sep=$'\n'$pad; width=$rest
      line=${line:$width}
    done
  done
  [ -n "$line" ] && printf '%s%s' "$sep" "$line"
  return 0
}

rows=$(sort -t $'\t' -k1,1nr "$tmpfile")
[ -n "$FILTER" ] && rows=$(echo "$rows" | grep -F "$FILTER" || true)
# --search: one python run over every row; ripgrep picks the lines, python
# counts. The rows come back with their hits, ordered by them, so -n keeps the
# best matches rather than the newest.
if [ -n "$SEARCH" ] && [ -n "$rows" ]; then
  search_in=$(mktemp)
  printf '%s\n' "$rows" > "$search_in"
  rows=$(sum_digest --search "$search_in" "$SEARCH" "$MIN_HITS") || { rm -f "$search_in"; exit 1; }
  rm -f "$search_in"
  [ -n "$rows" ] || { echo "No session mentions /$SEARCH/$( [ "$MIN_HITS" -gt 1 ] && echo " $MIN_HITS or more times")."; exit 0; }
fi
[ "$LIMIT" != 0 ] && rows=$(echo "$rows" | head -n "$LIMIT")


if [ "$DELETE_MODE" = 1 ]; then
  candidates=$(printf '%s\n' "$rows" | awk -F'\t' \
      -v ids="$RM_IDS" -v older="$OLDER_THAN" -v maxt="$MAX_TURNS" -v all="$RM_ALL" \
      -v now="$now" -v cur="$CURRENT_ID" '
    BEGIN {
      n = split(ids, a, ",")
      nwant = 0
      for (i = 1; i <= n; i++) {
        gsub(/^[ \t]+|[ \t]+$/, "", a[i])
        if (a[i] != "") { want[a[i]] = 1; nwant++ }
      }
    }
    $2 == "" { next }
    {
      if ($2 == cur) next
      if (all != 1 && nwant > 0 && !($2 in want)) next
      if (older != "" && (now - $1) < older * 86400) next
      if (maxt != "" && $4 + 0 > maxt + 0) next
      print
    }
  ')

  if [ -z "$candidates" ]; then
    echo "No sessions match. Nothing to delete."
    [ -n "$RM_IDS" ] && echo "(the live session is always excluded; check the id with: claude-sessions)"
    exit 0
  fi

  # Resolve the real footprint, so the report counts only paths that exist.
  paths_file=$(mktemp)
  trap 'rm -f "$tmpfile" "$paths_file"' EXIT

  echo "Sessions selected for deletion:"
  echo
  printf "%-36s %-10s %-6s %-11s %s\n" "SESSION ID" "LAST" "TURNS" "DATE" "DIR"
  count=0
  while IFS=$'\t' read -r mtime sid cwd turns fpath; do
    [ -z "$sid" ] && continue
    count=$(( count + 1 ))
    date_str=$(date -d "@$mtime" +"%m-%d %H:%M" 2>/dev/null || date -r "$mtime" +"%m-%d %H:%M")
    printf "%-36s %-10s %-6s %-11s %s\n" \
      "$sid" "$(format_age "$mtime")" "$turns" "$date_str" "$(shorten_dir "$cwd")"
    # 'if' rather than '&&': a false test as the loop's last command would make
    # the loop exit non-zero and set -e would kill the script mid-report.
    footprint_of "$sid" "$fpath" | while IFS= read -r p; do
      if [ -e "$p" ]; then printf '%s\n' "$p"; fi
    done >> "$paths_file"
  done <<< "$candidates"

  npaths=$(wc -l < "$paths_file" | tr -d ' ')
  # NUL-separated so paths containing spaces are measured correctly.
  total=$(tr '\n' '\0' < "$paths_file" | du -scb --files0-from=- 2>/dev/null | tail -1 | cut -f1)
  [ -n "$total" ] || total=0
  human=$(numfmt --to=iec --suffix=B "$total" 2>/dev/null || echo "${total}B")

  echo
  echo "$count session(s), $npaths path(s), $human total."

  if [ "$DRY_RUN" = 1 ] || { [ "$BULK" = 1 ] && [ "$APPLY" != 1 ]; }; then
    echo
    echo "Dry run. Nothing deleted."
    if [ "$DRY_RUN" != 1 ]; then
      echo "To delete: re-run the same command with --apply"
    fi
    exit 0
  fi

  if [ "$ASSUME_YES" != 1 ]; then
    if [ ! -t 0 ]; then
      echo "Refusing to delete unattended: pass --yes when stdin is not a terminal." >&2
      exit 1
    fi
    printf 'Delete these %s session(s)? [y/N] ' "$count"
    read -r reply
    case "$reply" in
      y|Y|yes|YES) ;;
      *) echo "Aborted."; exit 1 ;;
    esac
  fi

  # Move, don't unlink: the trash mirrors absolute paths so a restore is a plain copy.
  stamp=$(date +%Y%m%d-%H%M%S)
  trash="$TRASH_ROOT/claude-$stamp"
  mkdir -p "$trash"
  # The trash holds whole conversations, a key pasted into one included, so
  # it is this user's only, like the summary cache: 0700 on the directories.
  chmod 700 "$TRASH_ROOT" "$trash" 2>/dev/null || true

  moved=0
  while IFS= read -r p; do
    [ -e "$p" ] || continue
    dest="$trash/${p#/}"
    mkdir -p "$(dirname "$dest")"
    if mv "$p" "$dest" 2>/dev/null; then
      moved=$(( moved + 1 ))
    else
      echo "  ! could not move $p" >&2
    fi
  done < "$paths_file"

  printf '%s\n' "$candidates" | cut -f2 > "$trash/.session-ids"

  echo
  echo "Deleted $count session(s): $moved path(s) moved to"
  echo "  $trash"
  echo
  echo "Restore everything:  cp -a $trash/* /"
  echo "Free the space:       delete that trash dir once you are sure"
  exit 0
fi

# An empty table is a shrug. Say which scope came up empty, since the answer
# differs: no sessions here, no session matching that substring, or none at all.
if [ -z "$(printf '%s' "$rows" | tr -d '[:space:]')" ]; then
  if [ "$PROJECT_SCOPE" = 1 ]; then
    echo "No sessions bound to $(pwd). Drop -p to see every project."
  elif [ -n "$FILTER" ]; then
    echo "No sessions whose directory contains \"$FILTER\"."
  else
    echo "No sessions recorded yet."
  fi
  exit 0
fi

# ABOUT: one python run over every row, before the table. A failure leaves the
# table as it was, without the column.
about_in=$(mktemp)
printf '%s\n' "$rows" > "$about_in"
with_about=$(sum_digest --about "$about_in" "$ABOUT_MIN" 2>/dev/null || true)
rm -f "$about_in"
[ -n "$with_about" ] && rows=$with_about
read -r dir_w about_any <<EOF_W
$(printf '%s\n' "$rows" | about_widths 3 "$([ -n "$SEARCH" ] && echo 7 || echo 6)")
EOF_W
# HITS sits after TURNS, as wide as its widest value.
hits_w=0
[ -n "$SEARCH" ] && hits_w=$(printf '%s\n' "$rows" |
  awk -F'\t' -v c=6 '{ if (length($c) > w) w = length($c) } END { print (w > 4 ? w : 4) }')
hits_col() { [ "$hits_w" -gt 0 ] && printf '%-*s ' "$hits_w" "$1"; return 0; }
# One row of the listing, with or without the HITS field before ABOUT.
read_row() {
  hits=''
  if [ -n "$SEARCH" ]; then
    IFS=$'\t' read -r mtime sid cwd turns fpath hits about
  else
    IFS=$'\t' read -r mtime sid cwd turns fpath about
  fi
}
# On a terminal ABOUT wraps. With room to spare it continues under its own
# column; in a narrow window that would be a tall strip of short lines, so it
# continues on the next line instead, indented, across the whole width.
room=0; rest=0; about_pad=''
if [ -t 1 ]; then
  cols=$(tput cols 2>/dev/null || echo 0)
  start=$(( 71 + dir_w + 2 + (hits_w > 0 ? hits_w + 1 : 0) ))
  room=$(( ${cols:-0} - start ))
  if [ "$room" -ge 50 ]; then
    rest=$room; about_pad=$(printf '%*s' "$start" '')
  else
    rest=$(( ${cols:-0} - 4 )); about_pad='    '
    [ "$room" -lt 20 ] && room=20
    [ "$rest" -lt 20 ] && rest=20
  fi
fi

if [ "$about_any" = 1 ]; then
  printf "%-3s %-36s %-10s %-6s %s%-11s %-${dir_w}s  %s\n" "" "SESSION ID (full)" "LAST" "TURNS" "$(hits_col HITS)" "DATE" "DIR" "ABOUT"
else
  printf "%-3s %-36s %-10s %-6s %s%-11s %s\n" "" "SESSION ID (full)" "LAST" "TURNS" "$(hits_col HITS)" "DATE" "DIR"
fi

while read_row; do
  [ -z "$sid" ] && continue
  mark=" "
  [ "$sid" = "$CURRENT_ID" ] && mark="*"
  age=$(format_age "$mtime")
  date_str=$(date -d "@$mtime" +"%m-%d %H:%M" 2>/dev/null || date -r "$mtime" +"%m-%d %H:%M")
  dir_disp=$(shorten_dir "$cwd")
  if [ "$about_any" = 1 ]; then
    printf "%-3s %-36s %-10s %-6s %s%-11s %-${dir_w}s  %s\n" "$mark" "$sid" "$age" "$turns" "$(hits_col "$hits")" "$date_str" "$dir_disp" "$(about_lines "$about" "$room" "$rest" "$about_pad")"
  else
    printf "%-3s %-36s %-10s %-6s %s%-11s %s\n" "$mark" "$sid" "$age" "$turns" "$(hits_col "$hits")" "$date_str" "$dir_disp"
  fi
done <<< "$rows"

echo
[ -n "$SEARCH" ] && echo "HITS: matches in your prompts / the model's replies / its tool calls and their output"
echo "Resume: cd <DIR> && claude --resume <SESSION ID>"
echo "Fork:   cd <DIR> && claude --resume <SESSION ID> --fork-session   (new session id, original untouched)"
echo "Delete: claude-sessions --rm <SESSION ID>            (asks to confirm; --dry-run to preview)"
