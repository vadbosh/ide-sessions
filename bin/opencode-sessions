#!/usr/bin/env bash
# opencode-sessions: list Opencode sessions with their bound directory +
# last-activity time, sorted newest-first. Same purpose as claude-sessions,
# adapted to Opencode's storage: sqlite db at
# ~/.local/share/opencode/opencode.db, table `session` (id, directory,
# time_updated epoch-ms, cost, tokens_*, model).
#
# Usage:
#   opencode-sessions              # all sessions, newest first
#   opencode-sessions -n 20        # limit to 20 rows
#   opencode-sessions <substring>  # filter by dir substring
#   opencode-sessions -p           # only sessions whose directory == $PWD exactly
#   opencode-sessions -f           # show full dir path instead of last 3 components
#
# Deleting (--rm confirms and deletes; bulk criteria dry-run until --apply):
#   opencode-sessions --rm <ID>[,<ID>...]     # by session id
#   opencode-sessions --older-than 30         # older than N days
#   opencode-sessions --max-turns 2           # trivial sessions (<= N messages)
#
# Unlike the file-based IDEs, a session here is rows across 8 tables. The schema
# declares ON DELETE CASCADE but `PRAGMA foreign_keys` defaults to OFF, so the
# cascade would silently not fire — every table is deleted explicitly inside one
# transaction instead. Child sessions (subagents, via parent_id) are pulled in
# too, otherwise deleting a parent leaves them orphaned and unreachable.
# Affected rows are dumped as INSERT statements into the trash dir first.

set -euo pipefail

DATA_DIR="${OPENCODE_DATA_DIR:-$HOME/.local/share/opencode}"
DB="$DATA_DIR/opencode.db"
TRASH_ROOT="${IDE_SESSIONS_TRASH:-$HOME/.cache/ide-sessions-trash}"
SUM_CACHE="${IDE_SESSIONS_SUM_CACHE:-$HOME/.cache/ide-sessions-summaries}"
LIMIT=0
FILTER=""
FULL_PATH=0
PROJECT_SCOPE=0
RM_IDS=""
RM_ALL=0
EVERYWHERE=0
OLDER_THAN=""
MAX_TURNS=""
APPLY=0
ASSUME_YES=0
DRY_RUN=0
SUM_ID=""
SUM_MODEL="${IDE_SESSIONS_SUM_MODEL:-}"
SUM_GAP=45
SUM_REFRESH=0
SUM_RAW=0
SUM_LANG=en

# Every table keyed by session_id; `session` itself is keyed by id.
CHILD_TABLES="part message todo session_share session_message session_context_epoch session_input"

usage() {
  cat <<'EOF'
Usage: opencode-sessions [-n LIMIT] [-f] [-p] [substring]
       opencode-sessions --sum <ID>
       opencode-sessions --sum-orig <ID>
       opencode-sessions --rm <ID>[,<ID>...]
       opencode-sessions -p --rm-all --apply
       opencode-sessions --older-than DAYS | --max-turns N --apply

  -n LIMIT          limit rows
  -f                full dir path instead of last 3 components
  -p                only sessions whose directory == $PWD exactly
  substring         filter by dir substring

Summary of one session, grouped by topic (English unless --sum-orig):
  --sum ID          summarize that session; the result is cached per session
  --sum-model M     model to summarize with (default: the one opencode uses)
  --sum-gap MIN     minutes of silence that start a new topic (default: 45)
  --sum-refresh     ignore the cached summary and ask the model again
  --sum-raw         print the extracted digest only — no model call, no cost
  --sum-orig [ID]   summarize in the session's own language, not English

Delete selection (combine freely; substring and -p narrow it further):
  --rm IDS          comma-separated session ids; confirms, then deletes
  --rm-all          every session the current filters select — see below
  --everywhere      the only way to run --rm-all with no scope at all
  --older-than N    sessions untouched for more than N days
  --max-turns N     sessions with N messages or fewer
  --apply           required by --older-than/--max-turns, which dry-run otherwise
  --yes, -y         skip the confirmation prompt (required when stdin is a pipe)
  --dry-run         report only, never delete
  --trash DIR       trash location (default: $HOME/.cache/ide-sessions-trash)

What deletes what. The scope comes from the same flags as the listing, and
nothing goes until --apply — without it you get the list and a dry-run note.

  opencode-sessions -p                          lists sessions whose directory is $PWD
  opencode-sessions -p --rm-all                 lists what --apply would delete, deletes nothing

  opencode-sessions -p --rm-all --apply         DELETES every session of this project
  opencode-sessions k8s --rm-all --apply        DELETES every session whose dir matches "k8s"
  opencode-sessions -p --older-than 30 --apply  DELETES this project's sessions untouched for 30+ days
  opencode-sessions -p --max-turns 20 --apply   DELETES this project's sessions of 20 turns or fewer
  opencode-sessions --max-turns 2 --apply       DELETES sessions of 2 turns or fewer, in every project

  opencode-sessions --rm-all                    refused: nothing narrows it
  opencode-sessions --rm-all --everywhere       lists every project; add --apply to DELETE all of it

Child (subagent) sessions of anything selected are deleted with their parent.
EOF
}

while [ $# -gt 0 ]; do
  case "$1" in
    -n) LIMIT="$2"; shift 2 ;;
    -f) FULL_PATH=1; shift ;;
    -p) PROJECT_SCOPE=1; shift ;;
    --rm) RM_IDS="$2"; shift 2 ;;
    --rm-all) RM_ALL=1; shift ;;
    --everywhere) EVERYWHERE=1; shift ;;
    --sum) SUM_ID="$2"; shift 2 ;;
    --sum-model) SUM_MODEL="$2"; shift 2 ;;
    --sum-gap) SUM_GAP="$2"; shift 2 ;;
    --sum-refresh) SUM_REFRESH=1; shift ;;
    --sum-raw) SUM_RAW=1; shift ;;
    # `--sum-orig <ID>` is the same request as `--sum <ID> --sum-orig`, and
    # typing both flags for one session is ceremony. A word after it that is
    # not itself a flag is the id.
    --sum-orig)
      SUM_LANG=orig; shift
      case "${1:-}" in ''|-*) ;; *) SUM_ID="$1"; shift ;; esac ;;
    --older-than) OLDER_THAN="$2"; shift 2 ;;
    --max-turns) MAX_TURNS="$2"; shift 2 ;;
    --trash) TRASH_ROOT="$2"; shift 2 ;;
    --apply) APPLY=1; shift ;;
    --yes|-y) ASSUME_YES=1; shift ;;
    --dry-run) DRY_RUN=1; shift ;;
    -h|--help) usage; exit 0 ;;
    -*) usage >&2; echo "unknown option: $1" >&2; exit 1 ;;
    *) FILTER="$1"; shift ;;
  esac
done

DELETE_MODE=0
[ -n "$RM_IDS$OLDER_THAN$MAX_TURNS" ] && DELETE_MODE=1
[ "$RM_ALL" = 1 ] && DELETE_MODE=1

# An explicit id list is intent enough to delete after a prompt. Bulk criteria
# can sweep up far more than intended, so they stay dry-run until --apply.
BULK=0
[ -n "$OLDER_THAN$MAX_TURNS" ] && BULK=1
# --rm-all is the widest selection there is, so it dry-runs like the rest.
[ "$RM_ALL" = 1 ] && BULK=1

# --rm-all with nothing to narrow it selects every session on the machine. That
# is the one command a person runs before reading the rest of the help, so it
# refuses: a scope has to be named, or the global sweep asked for by name.
if [ "$RM_ALL" = 1 ] && [ "$PROJECT_SCOPE" != 1 ] && [ -z "$FILTER" ] && [ "$EVERYWHERE" != 1 ]; then
  {
    echo "--rm-all needs something to narrow it — on its own it means every session"
    echo "of every project on this machine."
    echo
    echo "  opencode-sessions -p --rm-all --apply          this project only"
    echo "  opencode-sessions <substring> --rm-all --apply  directories matching <substring>"
    echo "  opencode-sessions --rm-all --everywhere        every project, listed first"
  } >&2
  exit 1
fi

for n in "$OLDER_THAN" "$MAX_TURNS"; do
  case "$n" in
    '') ;;
    *[!0-9]*) echo "--older-than/--max-turns want a plain number, got: $n" >&2; exit 1 ;;
  esac
done

if ! command -v python3 >/dev/null 2>&1; then
  echo "python3 not found — needed to read the opencode database" >&2
  exit 1
fi
if [ ! -f "$DB" ]; then
  echo "no opencode db at $DB" >&2
  exit 1
fi

# The queries go through Python's bundled sqlite3 module rather than the
# `sqlite3` CLI. The CLI is a separate package that is simply absent on many
# machines — this one included, where the script printed "sqlite3 not found"
# and listed nothing — while the module ships with Python itself.
db_tsv() {
  python3 - "$DB" "$1" <<'PY'
import sqlite3, sys
con = sqlite3.connect(sys.argv[1], timeout=10)
for row in con.execute(sys.argv[2]):
    print('\t'.join('' if v is None else str(v) for v in row))
PY
}

# Keep only the tables this database actually has. opencode's schema moves
# between versions, and a table named here that is missing there would abort a
# delete over rows that do not exist — `no such table: todo` for a session with
# no todos.
CHILD_TABLES=$(python3 - "$DB" "$CHILD_TABLES" <<'PY'
import sqlite3, sys
con = sqlite3.connect(sys.argv[1], timeout=10)
have = {r[0] for r in con.execute(
    "SELECT name FROM sqlite_master WHERE type = 'table'")}
print(' '.join(t for t in sys.argv[2].split() if t in have))
PY
)

db_exec() {
  python3 - "$DB" "$1" <<'PY'
import sqlite3, sys
con = sqlite3.connect(sys.argv[1], timeout=10)
con.executescript(sys.argv[2])
con.commit()
PY
}

now=$(date +%s)

format_age() {
  local d=$(( now - $1 ))
  if [ "$d" -lt 60 ]; then echo "${d}s ago"
  elif [ "$d" -lt 3600 ]; then echo "$(( d/60 ))m ago"
  elif [ "$d" -lt 86400 ]; then echo "$(( d/3600 ))h ago"
  else echo "$(( d/86400 ))d ago"
  fi
}

shorten_dir() {
  local p="$1"
  [ "$FULL_PATH" = 1 ] && { echo "$p"; return; }
  echo "$p" | awk -F/ '{ n=NF; if (n<=3) print $0; else print $(n-2)"/"$(n-1)"/"$n }'
}

# --sum and --sum-orig answer the same question in two languages, so they cache
# side by side; one file would mean each flag silently discarding the other's
# work.
SUM_FILE_SUFFIX=""
[ "$SUM_LANG" = orig ] && SUM_FILE_SUFFIX=".orig"

# ── summary of one session ──────────────────────────────────────────────────
#
# A session is thousands of rows in `part`; what a person wants back a week
# later is four bullets. The work is split in two: a local pass that throws away
# everything a summary cannot use (tool output, reasoning, step markers), and
# one model call over what is left. Only the first pass knows opencode's schema
# — everything after it is the same in all three scripts.
#
# The summary comes back in English whatever language the session was held in,
# because that is what the prompt asks for; a purely local extraction could not
# translate, which is why a model is called at all. --sum-orig asks for the
# session's own language instead — same digest, one rule swapped.

# The digest. Reads the session's messages, prints a compact per-topic block.
# Topics are cut where the work actually stopped: a silence longer than
# --sum-gap. The directory cannot change inside an opencode session, so it is
# not a boundary here.
sum_digest() {
  python3 - "$DB" "$1" "$SUM_GAP" <<'PY'
import json, re, sqlite3, sys, datetime

db, sid, gap_min = sys.argv[1], sys.argv[2], int(sys.argv[3])
gap = gap_min * 60
con = sqlite3.connect(db, timeout=10)

row = con.execute("SELECT directory FROM session WHERE id = ?", (sid,)).fetchone()
if row is None:
    sys.exit(4)
cwd = row[0] or '?'

# ── redaction ───────────────────────────────────────────────────────────────
#
# A session can contain a credential: pasted into a prompt, echoed back in a
# reply, printed inside an error. The digest copies reply text, so without this
# a key would travel three ways at once — to whatever API summarizes (not
# necessarily the vendor the session itself ran on), into a cache file on disk,
# and onto the terminal of the session asking for the summary, which is itself
# being recorded.
#
# So masking happens here, before anything leaves the process, and --sum-raw
# shows exactly what would have been sent. Two tiers: a shape that can only be
# a token is masked anywhere, while a shape that merely could
# be one — 40 characters of base62, 32 of hex — is masked only where a
# credential word stands beside it. Otherwise every git SHA in the session
# would come back as <REDACTED>.
PROVIDER = re.compile(
    r'AKIA[0-9A-Z]{16}'
    r'|(?:ghp|gho|ghs|ghu|ghr)_[A-Za-z0-9]{36,}'
    r'|github_pat_[A-Za-z0-9_]{22,}'
    r'|glpat-[A-Za-z0-9_-]{20,}'
    r'|xox[baprs]-[A-Za-z0-9-]{10,}'
    r'|tvly-[A-Za-z0-9-]{10,}'
    r'|AIza[A-Za-z0-9_-]{35}'
    r'|(?:sk|rk)_live_[A-Za-z0-9]{20,}'
    r'|sk-(?:or-v1-|proj-|ant-)?[A-Za-z0-9-]{20,}'
    r'|ATATT[A-Za-z0-9_=.-]{20,}'
    r'|at-[A-Za-z0-9]{30,}'
    r'|hf_[A-Za-z0-9]{30,}'
    r'|dckr_pat_[A-Za-z0-9_-]{20,}'
    r'|eyJ[A-Za-z0-9_-]{10,}\.eyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]*'
    r'|-----BEGIN (?:RSA |EC |DSA |OPENSSH |PGP )?PRIVATE KEY-----')

# Credentials inside a URL. Separate from the list above so the scheme and host
# survive: postgres://admin:pw@db/app is worth reading as "postgres, db, app".
URL_CRED = re.compile(r'://[^/:@\s]+:([^/:@\s]{3,})@')

# A label and the value after it. The label is what a secret is called; the
# value is only required to be long, because its shape says nothing.
#
# Huawei Cloud and OpenStack are the reason this tier exists in this form. Their
# access key is 20 characters of upper case and digits and the secret 40 of
# base62 — the same shapes as a git SHA, a build id, half the identifiers in
# ordinary output — so no pattern can take them without masking everything. The
# variable name can, and it is right there on the line. Jira reaches here too
# when a token is passed as --token rather than carrying its ATATT prefix.
LABEL = (r'(?:--?)?(?:pass|passwd|password|passphrase|pass-phrase'
         r'|token|secret|api[-_]?key|apikey|auth[-_]?token|access[-_]?key'
         r'|secret[-_]?key|client[-_]?secret|private[-_]?key|credential'
         r'|jira[-_]?(?:api[-_]?)?token'
         r'|hw[-_]?(?:access|secret)(?:[-_]?key)?'
         r'|huaweicloud?[-_]?[a-z_]*key'
         r'|os[-_](?:access|secret)[-_]?key'
         # …_AK and …_SK: Huawei's own SDKs spell the pair that way, and the
         # value carries no prefix at all, so the suffix is the whole signal.
         r'|(?:hw|huawei|huaweicloud|obs|os)[-_][a-z_0-9]*[-_]?[as]k)s?[A-Z0-9_]*')
VALUE = r'[A-Za-z0-9+/=_.~-]{16,}'

# Assignment first — NAME=value, NAME: value, Authorization: Bearer value —
# then the flag form, --pass value. Both keep the label readable: a summary that
# hides which credential was involved answers nothing.
NAMED = re.compile(r'(%s)(\s*[=:]\s*(?:Bearer\s+)?)([\'"]?)(%s)' % (LABEL, VALUE), re.I)
FLAGGED = re.compile(r'(%s)(\s+)([\'"]?)(%s)' % (LABEL, VALUE), re.I)

# A line that talks about credentials at all. Only there is a long anonymous
# run treated as a secret.
CRED_WORD = re.compile(
    r'token|secret|password|passwd|credential|api[ _-]?key|access[ _-]?key'
    r'|huawei|openstack|jira|токен|пароль|секрет|ключ', re.I)
HIGH_ENTROPY = re.compile(r'\b[A-Za-z0-9_-]{40,}\b|\b[A-Fa-f0-9]{32,}\b')

def mask(m):
    return '<REDACTED:%d>' % len(m.group(0))

def redact(text):
    out = []
    for line in (text or '').splitlines():
        line = PROVIDER.sub(mask, line)
        line = URL_CRED.sub(
            lambda m: '://<REDACTED:%d>@' % len(m.group(1)), line)
        # A value already masked is left alone: masking the marker again would
        # overwrite the real length with the marker's own.
        for pat in (NAMED, FLAGGED):
            line = pat.sub(
                lambda m: m.group(0) if m.group(4).startswith('<REDACTED:')
                else '%s%s%s<REDACTED:%d>' % (m.group(1), m.group(2),
                                              m.group(3), len(m.group(4))),
                line)
        if CRED_WORD.search(line):
            line = HIGH_ENTROPY.sub(mask, line)
        out.append(line)
    return '\n'.join(out)

turns = []
for role, created, data in con.execute("""
        SELECT json_extract(m.data, '$.role'), p.time_created, p.data
        FROM part p JOIN message m ON m.id = p.message_id
        WHERE p.session_id = ?
        ORDER BY p.time_created, p.id""", (sid,)):
    try:
        d = json.loads(data)
    except ValueError:
        continue
    ep = (created or 0) / 1000.0
    if d.get('type') == 'text':
        txt = redact((d.get('text') or '').strip())
        if txt:
            turns.append({'ep': ep, 'role': role or '?', 'txt': txt,
                          'tools': []})
    elif d.get('type') == 'tool':
        # The tool's input is its command — that is tool output, which a
        # summary must not quote. The name is enough.
        turns.append({'ep': ep, 'role': 'tool', 'txt': '',
                      'tools': [d.get('tool') or '?']})

if not any(t['txt'] for t in turns):
    sys.exit(3)

# ── segment ─────────────────────────────────────────────────────────────────
segments, cur, last_ep = [], [], None
for t in turns:
    if last_ep is not None and t['ep'] and t['ep'] - last_ep > gap and cur:
        segments.append(cur)
        cur = []
    cur.append(t)
    last_ep = t['ep'] or last_ep
if cur:
    segments.append(cur)

def when(ep):
    return datetime.datetime.fromtimestamp(ep).strftime('%Y-%m-%d %H:%M') if ep else '?'

def cut(s, n):
    s = ' '.join(s.split())
    return s if len(s) <= n else s[:n - 1] + '…'

# Both ends of a segment carry meaning — the ask at the start, the outcome at
# the end. The middle is where repetition lives, so that is what is dropped.
def sample(items, keep):
    if len(items) <= keep:
        return items
    head = keep // 2
    return items[:head] + items[-(keep - head):]

out = []
for i, seg in enumerate(segments, 1):
    users = [t for t in seg if t['role'] == 'user' and t['txt']]
    bots = [t for t in seg if t['role'] == 'assistant' and t['txt']]
    tools = {}
    for t in seg:
        for name in t['tools']:
            tools[name] = tools.get(name, 0) + 1
    stamps = [t['ep'] for t in seg if t['ep']]
    out.append('## part %d — %s — %s → %s — %d turns'
               % (i, cwd, when(stamps[0] if stamps else 0),
                  when(stamps[-1] if stamps else 0), len(users) + len(bots)))
    for t in sample(users, 8):
        out.append('ASKED: ' + cut(t['txt'], 400))
    for t in sample(bots, 4):
        out.append('REPLIED: ' + cut(t['txt'], 220))
    if tools:
        top = sorted(tools.items(), key=lambda kv: -kv[1])[:8]
        out.append('TOOLS: ' + ', '.join('%s x%d' % (k, v) for k, v in top))
    out.append('')

print('\n'.join(out))
PY
}

# The language rule is the whole difference between --sum and --sum-orig, so it
# is one variable inside one prompt. Two separate prompts would drift apart at
# the first edit to everything they have in common.
if [ "$SUM_LANG" = orig ]; then
  SUM_LANG_RULE='- Write in the language the session itself was held in. Where more than one was
  used, take the language the user typed most, and use only that one — do not
  mix two languages in a summary and do not translate into English.'
else
  SUM_LANG_RULE='- Write in English only. One session can mix languages — Russian, German, any
  other, sometimes inside a single sentence. Translate all of it; never leave a
  phrase in the original language and never answer in it.'
fi

# What the model is asked for. Kept next to the digest so the two are read
# together: the digest decides what the model can see, this decides what it
# does with it.
SUM_PROMPT="Below is a machine-made digest of one AI coding session: the user's asks, short excerpts of the replies, and tool counts, already split into parts.

Write a summary of what was DONE in that session.

Rules:
$SUM_LANG_RULE
- Keep verbatim, untranslated: code, file paths, commands, flags, identifiers,
  branch names, error strings.
- Never write out a key, token, password or other credential, even if one
  appears in the digest. Anything already masked as <REDACTED:N> stays masked;
  say what it was for, not what it was.
- One '### ' heading per distinct topic, 4-8 words, naming the actual subject.
- Under each heading, 2-4 bullets. A bullet is <= 14 words, past tense, and names
  something concrete: a file, a command, a tool, a decision, a number.
- Merge parts that are the same topic. At most 5 headings for the whole session.
- Say what was decided or found, not what was discussed.
- No preamble, no closing remarks, no restating these rules.
- Do not read any file and do not run any command: the digest is all there is."

# A summary of a long session is one model call and takes as long as it takes —
# 79 seconds for a ten-part digest, measured. A terminal with nothing on it for
# that long reads as a hang, so say what is happening and count the seconds.
#
# Only when stderr is a terminal: in a pipe or a script the carriage returns
# would end up in a file, and the summary on stdout has to stay clean either
# way.
SUM_PROGRESS_PID=""
sum_progress_start() {
  [ -t 2 ] || return 0
  local msg="$1"
  (
    i=0
    while :; do
      printf '\r  %s… %ds' "$msg" "$i" >&2
      i=$((i + 1))
      sleep 1
    done
  ) &
  SUM_PROGRESS_PID=$!
}

sum_progress_stop() {
  [ -n "$SUM_PROGRESS_PID" ] || return 0
  kill "$SUM_PROGRESS_PID" 2>/dev/null || true
  wait "$SUM_PROGRESS_PID" 2>/dev/null || true
  SUM_PROGRESS_PID=""
  # \033[K clears what the counter left on the line; without it the next
  # output lands on top of half a progress line.
  printf '\r\033[K' >&2
}

# An interrupted run must not leave the counter running in the background.
trap 'sum_progress_stop' EXIT INT TERM

if [ -n "$SUM_ID" ]; then
  sum_fail() {
    case $1 in
      4) echo "No session $SUM_ID in $DB" >&2
         echo "List the ids with: opencode-sessions" >&2 ;;
      *) echo "Nothing to summarize: $SUM_ID has no text messages." >&2 ;;
    esac
    exit 1
  }

  if [ "$SUM_RAW" = 1 ]; then
    sum_digest "$SUM_ID" || sum_fail $?
    exit 0
  fi

  # opencode resolves the model itself — config, then last used. Passing one
  # here would override a choice the user already made for this machine, so
  # --sum-model is the only way a model name enters this script.
  model="${SUM_MODEL:-}"
  src_mtime=$(db_tsv "SELECT time_updated FROM session WHERE id = '$SUM_ID';")
  key="ide-sessions-sum v1 src=${src_mtime:-0} model=${model:-default} gap=$SUM_GAP lang=$SUM_LANG"
  cache_file="$SUM_CACHE/opencode-$SUM_ID$SUM_FILE_SUFFIX.md"

  # The cache is keyed by the session's own time_updated, so a session that has
  # since been continued re-summarizes itself and one that has not costs
  # nothing twice.
  # Checked before the digest is built, not after: parsing a large transcript
  # takes about 0.6 s, and doing it to then throw the result away was most of
  # what a cache hit cost.
  if [ "$SUM_REFRESH" != 1 ] && [ -f "$cache_file" ] &&
     [ "$(head -1 "$cache_file")" = "<!-- $key -->" ]; then
    tail -n +2 "$cache_file"
    exit 0
  fi

  digest=$(sum_digest "$SUM_ID") || sum_fail $?

  command -v opencode >/dev/null 2>&1 || {
    echo "opencode CLI not found — needed to write the summary." >&2
    echo "Use --sum-raw for the extracted digest without a model." >&2
    exit 1
  }

  stream=$(mktemp)
  trap 'rm -f "$stream"' EXIT

  # --format json, not the pretty output: the default prints a header line and
  # ANSI colour, which would end up inside the cached summary.
  set -- run --pure --format json --title "ide-sessions --sum $SUM_ID"
  [ -n "$model" ] && set -- "$@" --model "$model"
  sum_progress_start "summarizing $(printf '%s\n' "$digest" | grep -c '^## part') part(s) with ${model:-the model opencode is set to}"

  opencode "$@" "$(printf '%s\n\n%s\n' "$SUM_PROMPT" "$digest")" \
    > "$stream" 2>/dev/null || true
  sum_progress_stop

  summary=$(python3 - "$stream" <<'PY'
import json, sys
parts = []
for line in open(sys.argv[1], errors='replace'):
    try:
        ev = json.loads(line)
    except ValueError:
        continue
    if ev.get('type') == 'text':
        parts.append((ev.get('part') or {}).get('text') or '')
print('\n'.join(p for p in parts if p).strip())
PY
)

  # Running opencode writes a session of its own. Left alone, every summary
  # would add a row to the very list this script exists to keep readable, so
  # the scratch session is removed by the title it was given.
  scratch=$(db_tsv "SELECT id FROM session WHERE title = 'ide-sessions --sum $SUM_ID';" || true)
  if [ -n "$scratch" ]; then
    scratch_list=$(printf '%s\n' "$scratch" | sed "s/.*/'&'/" | paste -sd, -)
    db_exec "
BEGIN IMMEDIATE;
$(for t in $CHILD_TABLES; do echo "DELETE FROM $t WHERE session_id IN ($scratch_list);"; done)
DELETE FROM session WHERE id IN ($scratch_list);
COMMIT;
" || true
  fi

  if [ -z "$summary" ]; then
    echo "The model returned nothing. Re-run with --sum-raw to see the digest." >&2
    exit 1
  fi

  # A summary can still name what a secret was for, and it is written without
  # being read again. Keep it to this user: 0700 on the directory, 0600 on the
  # file, set before the content goes in.
  mkdir -p "$SUM_CACHE"
  chmod 700 "$SUM_CACHE" 2>/dev/null || true
  : > "$cache_file"
  chmod 600 "$cache_file" 2>/dev/null || true
  { printf '<!-- %s -->\n' "$key"; printf '%s\n' "$summary"; } > "$cache_file"
  # Which model wrote this goes to stderr, so `--sum | …` stays pure summary.
  echo "summarized with ${model:-the model opencode is set to}" >&2
  printf '%s\n' "$summary"
  exit 0
fi

rows=$(db_tsv "
SELECT s.id, s.directory, s.time_updated,
       (SELECT COUNT(*) FROM message m WHERE m.session_id = s.id) AS msgs,
       printf('%.2f', COALESCE(s.cost, 0))
FROM session s
WHERE s.directory IS NOT NULL AND s.directory != ''
ORDER BY s.time_updated DESC;
" 2>&1)

if [ "$PROJECT_SCOPE" = 1 ]; then
  cur="$(pwd)"
  rows=$(echo "$rows" | awk -F'\t' -v c="$cur" '$2==c')
fi
[ -n "$FILTER" ] && rows=$(echo "$rows" | grep -F "$FILTER" || true)
[ "$LIMIT" != 0 ] && rows=$(echo "$rows" | head -n "$LIMIT")

if [ "$DELETE_MODE" = 1 ]; then
  seeds=$(printf '%s\n' "$rows" | awk -F'\t' \
      -v ids="$RM_IDS" -v older="$OLDER_THAN" -v maxt="$MAX_TURNS" -v all="$RM_ALL" -v now="$now" '
    BEGIN {
      n = split(ids, a, ",")
      nwant = 0
      for (i = 1; i <= n; i++) {
        gsub(/^[ \t]+|[ \t]+$/, "", a[i])
        if (a[i] != "") { want[a[i]] = 1; nwant++ }
      }
    }
    $1 == "" { next }
    {
      mtime = int($3 / 1000)
      if (all != 1 && nwant > 0 && !($1 in want)) next
      if (older != "" && (now - mtime) < older * 86400) next
      if (maxt != "" && $4 + 0 > maxt + 0) next
      print $1
    }
  ')

  if [ -z "$seeds" ]; then
    echo "No sessions match. Nothing to delete."
    exit 0
  fi

  ids_file=$(mktemp)
  trap 'rm -f "$ids_file"' EXIT

  # Expand to descendants. The seed ids are passed as bound parameters, so no
  # id is ever interpolated into SQL text.
  #
  # They go in as an argument, not on stdin: `python3 - <<'PY'` already uses
  # stdin for the program itself, so a piped seed list is read by nobody. That
  # silently selected zero sessions — `--rm` of two ids that were right there in
  # the listing reported "0 session(s)" and deleted nothing.
  python3 - "$DB" "$seeds" > "$ids_file" <<'PY'
import sqlite3, sys
con = sqlite3.connect(sys.argv[1], timeout=10)
seeds = [s.strip() for s in sys.argv[2].splitlines() if s.strip()]
con.execute("CREATE TEMP TABLE seed(id TEXT)")
con.executemany("INSERT INTO seed VALUES (?)", [(s,) for s in seeds])
rows = con.execute("""
WITH RECURSIVE targets(id) AS (
  SELECT id FROM session WHERE id IN (SELECT id FROM seed)
  UNION
  SELECT s.id FROM session s JOIN targets t ON s.parent_id = t.id
)
SELECT id FROM targets
""")
for (sid,) in rows:
    print(sid)
PY

  n_seeds=$(printf '%s\n' "$seeds" | grep -c . || true)
  n_total=$(grep -c . < "$ids_file" || true)

  # Seeds that expand to nothing mean the selection and the database disagree,
  # which is a failure, not an empty result — reporting "0 session(s)" and
  # carrying on would look like a successful delete.
  if [ "$n_total" = 0 ]; then
    echo "Selected $n_seeds session(s), but none of them is in $DB." >&2
    echo "List the ids with: opencode-sessions" >&2
    exit 1
  fi

  in_list=$(sed "s/.*/'&'/" "$ids_file" | paste -sd, -)

  echo "Sessions selected for deletion:"
  echo
  printf "%-30s %-10s %-6s %-8s %-11s %s\n" "SESSION ID" "LAST" "MSGS" "COST" "DATE" "DIR"
  db_tsv "
    SELECT s.id, s.directory, s.time_updated,
           (SELECT COUNT(*) FROM message m WHERE m.session_id = s.id),
           printf('%.2f', COALESCE(s.cost, 0)),
           CASE WHEN s.parent_id IS NULL OR s.parent_id = '' THEN '' ELSE 'child' END
    FROM session s WHERE s.id IN ($in_list)
    ORDER BY s.time_updated DESC;" |
  while IFS=$'\t' read -r sid directory tupd msgs cost kind; do
    [ -z "$sid" ] && continue
    mtime=$(( tupd / 1000 ))
    date_str=$(date -d "@$mtime" +"%m-%d %H:%M" 2>/dev/null || date -r "$mtime" +"%m-%d %H:%M")
    printf "%-30s %-10s %-6s \$%-7s %-11s %s %s\n" \
      "$sid" "$(format_age "$mtime")" "$msgs" "$cost" "$date_str" "$(shorten_dir "$directory")" "$kind"
  done

  echo
  echo "Row counts to be removed:"
  for t in $CHILD_TABLES; do
    c=$(db_tsv "SELECT COUNT(*) FROM $t WHERE session_id IN ($in_list);")
    [ "$c" = 0 ] || printf '  %-24s %s\n' "$t" "$c"
  done
  printf '  %-24s %s\n' "session" "$n_total"

  echo
  if [ "$n_total" -gt "$n_seeds" ]; then
    echo "$n_seeds selected + $(( n_total - n_seeds )) child session(s) = $n_total total."
  else
    echo "$n_total session(s)."
  fi

  if [ "$DRY_RUN" = 1 ] || { [ "$BULK" = 1 ] && [ "$APPLY" != 1 ]; }; then
    echo
    echo "Dry run. Nothing deleted."
    if [ "$DRY_RUN" != 1 ]; then
      echo "To delete: re-run the same command with --apply"
    fi
    exit 0
  fi

  if [ "$ASSUME_YES" != 1 ]; then
    if [ ! -t 0 ]; then
      echo "Refusing to delete unattended: pass --yes when stdin is not a terminal." >&2
      exit 1
    fi
    printf 'Delete these %s session(s) from the database? [y/N] ' "$n_total"
    read -r reply
    case "$reply" in
      y|Y|yes|YES) ;;
      *) echo "Aborted."; exit 1 ;;
    esac
  fi

  stamp=$(date +%Y%m%d-%H%M%S)
  trash="$TRASH_ROOT/opencode-$stamp"
  mkdir -p "$trash"
  dump="$trash/rows.sql"

  # Dump before deleting: the DB is too big to copy wholesale for every prune.
  # This replaces the CLI's `.mode insert`, quoting values the same way sqlite
  # does so the dump can be replayed with either tool.
  python3 - "$DB" "$dump" "$stamp" "session $CHILD_TABLES" "$in_list" <<'PY'
import sqlite3, sys

db, out_path, stamp, tables, in_list = sys.argv[1:6]
con = sqlite3.connect(db, timeout=10)

def literal(v):
    if v is None:
        return 'NULL'
    if isinstance(v, (int, float)):
        return repr(v)
    if isinstance(v, bytes):
        return "X'%s'" % v.hex()
    return "'%s'" % str(v).replace("'", "''")

with open(out_path, 'w') as out:
    out.write('-- opencode session rows removed %s\n' % stamp)
    out.write('BEGIN;\n')
    for t in tables.split():
        col = 'id' if t == 'session' else 'session_id'
        cur = con.execute('SELECT * FROM %s WHERE %s IN (%s)' % (t, col, in_list))
        names = [d[0] for d in cur.description]
        for row in cur:
            out.write('INSERT INTO %s(%s) VALUES(%s);\n'
                      % (t, ','.join(names), ','.join(literal(v) for v in row)))
    out.write('COMMIT;\n')
PY

  cp "$ids_file" "$trash/.session-ids"

  # Cached summaries are files, not rows: the dump above cannot carry them, so
  # they move into the same trash directory and restore with a plain copy.
  while IFS= read -r sid; do
    [ -n "$sid" ] || continue
    for path in "$SUM_CACHE/opencode-$sid.md" "$SUM_CACHE/opencode-$sid.orig.md"; do
      [ -e "$path" ] || continue
      mkdir -p "$trash/${path%/*}"
      mv "$path" "$trash/${path#/}" 2>/dev/null || true
    done
  done < "$ids_file"

  db_exec "
BEGIN IMMEDIATE;
$(for t in $CHILD_TABLES; do echo "DELETE FROM $t WHERE session_id IN ($in_list);"; done)
DELETE FROM session WHERE id IN ($in_list);
COMMIT;
"

  left=$(db_tsv "SELECT COUNT(*) FROM session WHERE id IN ($in_list);")

  echo
  echo "Deleted $n_total session(s). Remaining matching rows in session: $left (expect 0)."
  echo "Row dump written to"
  echo "  $dump  ($(wc -l < "$dump" | tr -d ' ') lines)"
  echo
  # Spelled out with python3 because the sqlite3 CLI is often not installed;
  # `sqlite3 $DB < $dump` does the same where it is.
  echo "Restore:         python3 -c \"import sqlite3,sys;sqlite3.connect('$DB').executescript(open('$dump').read())\""
  echo "Reclaim space:   python3 -c \"import sqlite3;sqlite3.connect('$DB').execute('VACUUM')\"   (optional, rewrites the db file)"
  exit 0
fi

# An empty table is a shrug. Say which scope came up empty, since the answer
# differs: no sessions here, no session matching that substring, or none at all.
if [ -z "$(printf '%s' "$rows" | tr -d '[:space:]')" ]; then
  if [ "$PROJECT_SCOPE" = 1 ]; then
    echo "No sessions bound to $(pwd). Drop -p to see every project."
  elif [ -n "$FILTER" ]; then
    echo "No sessions whose directory contains \"$FILTER\"."
  else
    echo "No sessions recorded yet."
  fi
  exit 0
fi

printf "%-30s %-10s %-6s %-8s %-11s %s\n" "SESSION ID (full)" "LAST" "MSGS" "COST" "DATE" "DIR"

while IFS=$'\t' read -r sid directory tupd msgs cost; do
  [ -z "$sid" ] && continue
  mtime=$(( tupd / 1000 ))
  age=$(format_age "$mtime")
  date_str=$(date -d "@$mtime" +"%m-%d %H:%M" 2>/dev/null || date -r "$mtime" +"%m-%d %H:%M")
  dir_disp=$(shorten_dir "$directory")
  printf "%-30s %-10s %-6s \$%-7s %-11s %s\n" "$sid" "$age" "$msgs" "$cost" "$date_str" "$dir_disp"
done <<< "$rows"

echo
echo "Resume: cd <DIR> && opencode -s <SESSION ID>   (add --fork to branch instead of continuing)"
echo "Delete: opencode-sessions --rm <SESSION ID>    (asks to confirm; --dry-run to preview)"
