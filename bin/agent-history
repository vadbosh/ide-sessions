#!/bin/bash
# Persistent prompt-history viewer across Claude Code, Codex CLI, Opencode.
#
# Usage:
#   agent-history <claude|codex|opencode> sessions [project-substring|all] [limit]
#       -> list sessions (id, first/last time, project, entry count) so you can pick one
#   agent-history <claude|codex|opencode> session=<id-substring> [limit]
#       -> show all entries for one session (id match is substring, no need for full id)
#   agent-history <claude|codex|opencode> [project-substring|all] [limit]
#       -> show entries filtered by project path; no argument = the current session
#
# Optional trailing --file : write result to a unique file in $OUTDIR instead of stdout,
# print only the path (for cases where direct dump is too large/noisy).
set -euo pipefail

case "${1:-}" in
  -h|--help) sed -n '2,13p' "$0" | sed 's/^# \?//'; exit 0 ;;
esac

ARGS=()
FILE_MODE=0
for a in "$@"; do
  if [ "$a" = "--file" ]; then FILE_MODE=1; else ARGS+=("$a"); fi
done

TOOL="${ARGS[0]:-claude}"
# no explicit filter given -> default to "self" (current session), NOT cwd.
# cwd-based defaulting is unreliable: sandboxed bash-tool cwd often doesn't
# match the real session's directory (esp. after --resume/-s into a session
# created elsewhere), and for opencode the tool's cwd can be a generic
# root (e.g. /root) that substring-matches a pile of unrelated sessions.
MODE_ARG="${ARGS[1]:-self}"

SESSIONS_MODE=0
SESSION_ID=""
FILTER="$MODE_ARG"

resolve_self() {
  case "$TOOL" in
    claude)
      # exact: Claude Code injects this into every bash-tool subprocess
      if [ -n "${CLAUDE_CODE_SESSION_ID:-}" ]; then
        SESSION_ID="$CLAUDE_CODE_SESSION_ID"
      else
        FILTER="$(pwd)"  # not running inside CC -> fall back to cwd match
      fi
      ;;
    codex)
      # heuristic: no session-id env var exposed to tools, but the very
      # phrase that triggered this skill was just appended as the last
      # line -> its session_id is "self" with very high reliability
      local F="$HOME/.codex/history.jsonl"
      SESSION_ID=$(tail -1 "$F" 2>/dev/null | jq -r '.session_id // empty' 2>/dev/null)
      if [ -z "$SESSION_ID" ]; then FILTER="$(pwd)"; fi
      ;;
    opencode)
      # heuristic: same idea — running /history just bumped this session's
      # time_updated, so the most-recently-updated session is "self"
      local DB="$HOME/.local/share/opencode/opencode.db"
      SESSION_ID=$(sqlite3 "$DB" "SELECT id FROM session ORDER BY time_updated DESC LIMIT 1;" 2>/dev/null)
      if [ -z "$SESSION_ID" ]; then FILTER="$(pwd)"; fi
      ;;
  esac
}

if [ "$MODE_ARG" = "sessions" ]; then
  SESSIONS_MODE=1
  FILTER="${ARGS[2]:-all}"
  LIMIT="${ARGS[3]:-40}"
elif [[ "$MODE_ARG" == session=* ]]; then
  SESSION_ID="${MODE_ARG#session=}"
  LIMIT="${ARGS[2]:-40}"
elif [ "$MODE_ARG" = "self" ]; then
  resolve_self
  LIMIT="${ARGS[2]:-40}"
else
  LIMIT="${ARGS[2]:-40}"
fi
[ "$FILTER" = "all" ] && FILTER="__ALL__"

run_query() {
case "$TOOL" in
  claude)
    F="$HOME/.claude/history.jsonl"
    [ -f "$F" ] || { echo "no $F"; exit 1; }
    if [ "$SESSIONS_MODE" = "1" ]; then
      jq -s -r --arg proj "$FILTER" '
        [.[] | select($proj=="__ALL__" or ((.project // "") | contains($proj)))] |
        group_by(.sessionId) |
        map({sid:.[0].sessionId, project:.[0].project,
             first:(min_by(.timestamp).timestamp), last:(max_by(.timestamp).timestamp), n:length}) |
        sort_by(.last) | .[] |
        [(.first/1000|floor|gmtime|strftime("%Y-%m-%d %H:%M")),
         (.last/1000|floor|gmtime|strftime("%Y-%m-%d %H:%M")), .sid, (.n|tostring), .project] | @tsv
      ' "$F" | tail -n "$LIMIT" | awk -F'\t' '{printf "%s..%s  n=%-4s %s  [%s]\n",$1,$2,$4,$3,$5}'
    elif [ -n "$SESSION_ID" ]; then
      jq -r --arg sid "$SESSION_ID" '
        select((.sessionId // "") | contains($sid)) |
        [(.timestamp/1000|floor|gmtime|strftime("%Y-%m-%d %H:%M")), .project, .display] | @tsv
      ' "$F" | tail -n "$LIMIT" | awk -F'\t' '{printf "%s [%s] %s\n",$1,$2,$3}'
    else
      jq -r --arg proj "$FILTER" '
        select($proj=="__ALL__" or ((.project // "") | contains($proj))) |
        [(.timestamp/1000|floor|gmtime|strftime("%Y-%m-%d %H:%M")), .project, .display] | @tsv
      ' "$F" | tail -n "$LIMIT" | awk -F'\t' '{printf "%s [%s] %s\n",$1,$2,$3}'
    fi
    ;;

  codex)
    F="$HOME/.codex/history.jsonl"
    [ -f "$F" ] || { echo "no $F"; exit 1; }
    MAP=$(mktemp)
    trap 'rm -f "$MAP"' RETURN
    find "$HOME/.codex/sessions" -name "*.jsonl" -exec \
      jq -r 'select(.type=="session_meta") | "\(.payload.session_id)\t\(.payload.cwd)"' {} \; \
      > "$MAP" 2>/dev/null
    if [ "$SESSIONS_MODE" = "1" ]; then
      jq -r '[.session_id, .ts, (.text|length)] | @tsv' "$F" | \
      awk -F'\t' -v proj="$FILTER" '
        BEGIN { while ((getline line < "'"$MAP"'") > 0) { split(line,a,"\t"); cwd[a[1]]=a[2] } }
        { c = (cwd[$1] != "" ? cwd[$1] : "?");
          if (proj != "__ALL__" && index(c, proj) == 0) next;
          if (!($1 in first) || $2 < first[$1]) first[$1]=$2;
          if (!($1 in last) || $2 > last[$1]) last[$1]=$2;
          n[$1]++; pc[$1]=c }
        END { for (s in n) printf "%s\t%s\t%s\t%s\t%s\n", first[s], last[s], s, n[s], pc[s] }
      ' | sort -n | tail -n "$LIMIT" | \
      awk -F'\t' '{ cmd1="date -d @"$1" +\"%Y-%m-%d %H:%M\""; cmd1|getline t1; close(cmd1);
                     cmd2="date -d @"$2" +\"%Y-%m-%d %H:%M\""; cmd2|getline t2; close(cmd2);
                     printf "%s..%s  n=%-4s %s  [%s]\n",t1,t2,$4,$3,$5 }'
    elif [ -n "$SESSION_ID" ]; then
      jq -r --arg sid "$SESSION_ID" 'select(.session_id | contains($sid)) | [.session_id, (.ts|todate), .text] | @tsv' "$F" | \
      awk -F'\t' -v proj="__ALL__" '
        BEGIN { while ((getline line < "'"$MAP"'") > 0) { split(line,a,"\t"); cwd[a[1]]=a[2] } }
        { c = (cwd[$1] != "" ? cwd[$1] : "?"); printf "%s [%s] %s\n", substr($2,1,16), c, $3 }
      ' | tail -n "$LIMIT"
    else
      jq -r '[.session_id, (.ts|todate), .text] | @tsv' "$F" | \
      awk -F'\t' -v proj="$FILTER" '
        BEGIN { while ((getline line < "'"$MAP"'") > 0) { split(line,a,"\t"); cwd[a[1]]=a[2] } }
        { c = (cwd[$1] != "" ? cwd[$1] : "?");
          if (proj == "__ALL__" || index(c, proj) > 0) printf "%s [%s] %s\n", substr($2,1,16), c, $3 }
      ' | tail -n "$LIMIT"
    fi
    ;;

  opencode)
    DB="$HOME/.local/share/opencode/opencode.db"
    [ -f "$DB" ] || { echo "no $DB"; exit 1; }
    if [ "$SESSIONS_MODE" = "1" ]; then
      if [ "$FILTER" = "__ALL__" ]; then WHERE="1=1"; else WHERE="s.directory LIKE '%${FILTER}%'"; fi
      sqlite3 -separator '	' "$DB" "
        SELECT datetime(MIN(m.time_created)/1000,'unixepoch'),
               datetime(MAX(m.time_created)/1000,'unixepoch'),
               s.id, COUNT(*), s.directory
        FROM message m
        JOIN session s ON s.id = m.session_id
        WHERE json_extract(m.data,'\$.role')='user' AND $WHERE
        GROUP BY s.id
        ORDER BY MAX(m.time_created) ASC
        LIMIT $LIMIT
      " | awk -F'\t' '{printf "%s..%s  n=%-4s %s  [%s]\n",$1,$2,$4,$3,$5}'
    elif [ -n "$SESSION_ID" ]; then
      sqlite3 -separator '	' "$DB" "
        SELECT datetime(m.time_created/1000,'unixepoch'), s.directory,
               replace(json_extract(p.data,'\$.text'), char(10), ' ')
        FROM message m
        JOIN part p ON p.message_id = m.id
        JOIN session s ON s.id = m.session_id
        WHERE json_extract(m.data,'\$.role')='user'
          AND json_extract(p.data,'\$.type')='text'
          AND s.id LIKE '%${SESSION_ID}%'
        ORDER BY m.time_created DESC
        LIMIT $LIMIT
      " | awk -F'\t' '{printf "%s [%s] %s\n",$1,$2,$3}' | tac
    else
      if [ "$FILTER" = "__ALL__" ]; then WHERE="1=1"; else WHERE="s.directory LIKE '%${FILTER}%'"; fi
      sqlite3 -separator '	' "$DB" "
        SELECT datetime(m.time_created/1000,'unixepoch'), s.directory,
               replace(json_extract(p.data,'\$.text'), char(10), ' ')
        FROM message m
        JOIN part p ON p.message_id = m.id
        JOIN session s ON s.id = m.session_id
        WHERE json_extract(m.data,'\$.role')='user'
          AND json_extract(p.data,'\$.type')='text'
          AND $WHERE
        ORDER BY m.time_created DESC
        LIMIT $LIMIT
      " | awk -F'\t' '{printf "%s [%s] %s\n",$1,$2,$3}' | tac
    fi
    ;;

  *)
    echo "usage: agent-history <claude|codex|opencode> [sessions [project|all] [limit] | session=<id> [limit] | project-substring|all [limit]] [--file]"
    exit 1
    ;;
esac
}

# Result files live in the user's state dir, not /tmp: a /tmp file was deleted
# after 60 minutes and was not always visible from the user's own shell, so the
# "FULL history" path printed on screen could already be gone when opened.
# Kept 7 days; mode 600 because prompts can quote secrets.
OUTDIR="${XDG_STATE_HOME:-$HOME/.local/state}/agent-history"
mkdir -p "$OUTDIR" && chmod 700 "$OUTDIR"
find "$OUTDIR" -maxdepth 1 -name 'agent-history-*.txt' -mtime +7 -delete 2>/dev/null || true

if [ "$FILE_MODE" = "1" ]; then
  OUT=$(mktemp "$OUTDIR/agent-history-${TOOL}-$$-XXXXXX.txt")
  run_query > "$OUT"
  echo "$OUT"
else
  # always dump the unlimited result to a file on the side, so nothing shown
  # on screen (clipped by terminal height) is ever actually lost
  FULL=$(mktemp "$OUTDIR/agent-history-${TOOL}-$$-XXXXXX-full.txt")
  SAVED_LIMIT="$LIMIT"
  LIMIT=999999999
  run_query > "$FULL"
  LIMIT="$SAVED_LIMIT"
  CNT=$(wc -l < "$FULL" | tr -d ' ')
  printf '\033[1;96m[FULL history: %s entries -> %s]\033[0m\n' "$CNT" "$FULL"
  echo
  run_query
fi
